<!DOCTYPE html>
<html lang="en">
  {MobaWeb.LayoutView.render("_head.html", conn: @conn, current_hero: nil)}
  <body class="landing-page">
    <main id="landing-page" class="landing">
      <picture id="landing-artwork" class="landing-artwork" aria-hidden="true">
        <source
          media="(max-width: 767px), (max-width: 1024px) and (orientation: portrait)"
          srcset={@landing_mobile_background}
        />
        <img
          id="landing-artwork-image"
          src={@landing_background}
          width="1672"
          height="941"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <h1 class="landing-brand">BROWSER <span>MOBA</span></h1>
      <div class="landing-content">
        <a id="landing-entrance" href={~p"/start"} class="landing-entrance">
          <span>ENTER THE ARENA</span>
        </a>
        <dl id="landing-stats" class="landing-stats" aria-label="Game statistics">
          <%= for {id, first, second, value} <- [
            {"players", "TOTAL", "PLAYERS", @counts.players},
            {"heroes", "HEROES", "INVOKED", @counts.heroes},
            {"matches", "MATCHES", "PLAYED", @counts.matches}
          ] do %>
            <div id={"landing-stat-#{id}"} class="landing-stat">
              <dt><span>{first}</span> <span>{second}</span></dt>
              <dd>{value}</dd>
            </div>
          <% end %>
        </dl>
      </div>
    </main>
  </body>
</html>
