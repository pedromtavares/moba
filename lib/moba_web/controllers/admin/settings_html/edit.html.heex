<section id="torch-toolbar">
  <div class="torch-container">
    <.link href={~p"/admin"} class="torch-button">Back to admin</.link>
  </div>
</section>

<section id="torch-header-and-content">
  <div class="torch-container">
    <header class="header">
      <h3>Site settings</h3>
    </header>
    <.form for={@form} action={~p"/admin/settings"} method="put" id="torch-form">
      <fieldset class="torch-panel" style="max-width: 760px; line-height: 1.6;">
        <legend><span>Google Analytics</span></legend>
        <p style="margin-bottom: 20px;">
          Connect your own GA4 property. Analytics is off by default and runs only in production.
        </p>
        <div class="torch-form-group">
          <div class="torch-form-group-input">
            <.input
              field={@form[:analytics_enabled]}
              type="checkbox"
              label="Enable Google Analytics"
              class="analytics-enabled-checkbox"
            />
          </div>
        </div>
        <div class="torch-form-group">
          <div class="torch-form-group-input">
            <.input
              field={@form[:analytics_measurement_id]}
              type="text"
              label="GA4 measurement ID"
              class="analytics-measurement-id"
              placeholder="G-XXXXXXXXXX"
              maxlength="32"
              aria-describedby="analytics-id-help"
            />
          </div>
        </div>
        <p id="analytics-id-help" style="margin: 8px 0 20px; color: #666;">
          Find it in Google Analytics → Admin → Data streams → your web stream. Paste the G- ID only.
        </p>
        <p style="margin-bottom: 20px;">
          Local, admin, account, and authentication pages are excluded. Changes apply on the next page load.
        </p>
        <details style="margin-bottom: 20px;">
          <summary>Track navigation between game pages</summary>
          <p>
            In your GA4 web stream, enable Enhanced measurement → Page views → Page changes based on browser history events.
          </p>
        </details>
        <div class="torch-submit-form">
          <button id="save-analytics-settings" type="submit" class="torch-submit-button">
            Save analytics settings
          </button>
        </div>
      </fieldset>
    </.form>
  </div>
</section>
