<section id="torch-toolbar">
  <div class="torch-container">
    <%= link("Cancel", to: ~p"/admin/skins", class: "torch-button") %>
  </div>
</section>

<section id="torch-header-and-content">
  <div class="torch-container">
    <header class="header">
      <h3>Edit Skin</h3>
    </header>
    <.skin_form changeset={@changeset} action={~p"/admin/skins/#{@skin}"} />
  </div>
</section>
