<section id="torch-toolbar">
  <div class="torch-container">
    <%= link("Cancel", to: ~p"/admin/skills", class: "torch-button") %>
  </div>
</section>

<section id="torch-header-and-content">
  <div class="torch-container">
    <header class="header">
      <h3>New Skill</h3>
    </header>
    <.skill_form changeset={@changeset} action={~p"/admin/skills"} skills={[]} />
  </div>
</section>
