<section id="torch-toolbar">
  <div class="torch-container">
    <%= link("Cancel", to: ~p"/admin/avatars", class: "torch-button") %>
  </div>
</section>

<section id="torch-header-and-content">
  <div class="torch-container">
    <header class="header">
      <h3>Edit Avatar</h3>
    </header>
    <.avatar_form changeset={@changeset} action={~p"/admin/avatars/#{@avatar}"} />
  </div>
</section>
