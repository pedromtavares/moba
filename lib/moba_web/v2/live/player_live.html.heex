<Layouts.app
  preview={@preview}
  flash={@flash}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code={@sidebar_code}
>
  <div class="user-profile">
    <.cinematic_header :if={@preview} {assigns} />
    <div class="row mt-2 profile-board">
      <div class="col-md-6 col-xl-4 profile-collection-column">
        <div class="collection-container" id="profile-collection">
          <.featured_hero_card
            :if={@featured && !@preview}
            preview={Map.get(assigns, :preview, false)}
            hero={@featured}
          />
          <div class="card collection mb-0">
            <div class="card-body pb-1 d-flex">
              <div class="row">
                <%= for hero <- @profile_collection do %>
                  <div class="col-3 text-center">
                    <a
                      href="javascript:;"
                      class={if @featured && @featured.id == hero["hero_id"], do: "current-featured"}
                      phx-click="set-featured"
                      phx-value-id={hero["hero_id"]}
                      phx-hook="Loading"
                      id={"set-featured-#{hero["hero_id"]}"}
                    >
                      <div class="avatar-container">
                        <img src={GH.image_url(hero["avatar"])} class={avatar_class(hero)} />
                        <.league_badge tier={hero["tier"]} variant="legacy" />
                      </div>
                    </a>
                  </div>
                <% end %>
                <%= for avatar <- @blank_collection do %>
                  <div class="col-3 text-center">
                    <div class="avatar-container">
                      <img src={GH.image_url(avatar)} class="avatar blank-avatar" />
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-4 profile-record-column">
        <div class="card" phx-hook="EqualHeight" phx-target=".collection-container" id="user-profile">
          <%= if !@preview && @player.id == @current_player.id do %>
            <h5 class="card-header font-17 text-white d-flex justify-content-between py-2">
              <.link navigate={preview_path(assigns, ~p"/users/settings")} class="text-white">
                <i class="ui-icon ui-edit mr-1"></i>Edit Profile
              </.link>
              <.link href="/auth/discord" class="text-white">
                <i class="ui-icon ui-chat-controller"></i> Connect Discord
              </.link>
              <.link href={preview_path(assigns, ~p"/users/log_out")} method="delete" class="text-white">
                <i class="ui-icon ui-sign-out"></i>
                <span class="d-none d-md-inline">Log out</span>
              </.link>
            </h5>
          <% end %>
          <div :if={!@preview} class="card-body p-2 text-center">
            <img
              src={"/images/pve/#{@player.pve_tier}.png"}
              class={"pvp-rank big-rank-shadow-#{shadow_rank(@player)}"}
              data-toggle="tooltip"
              title={"#{Moba.pve_tiers[@player.pve_tier]} (#{@player.pve_tier})"}
            />
            <h2 class="text-white f-rpg">
              <span class={"name-shadow-#{shadow_rank(@player)}"}>
                <%= if @player.user.discord.id do %>
                  <img
                    src={@player.user.discord.avatar}
                    class="discord-avatar"
                    data-toggle="tooltip"
                    title={"Discord: #{@player.user.discord.nickname}"}
                  />
                <% end %>
                {username(@player)}
              </span>
            </h2>
          </div>
          <hr />
          <div :if={!@preview} class="row no-gutters py-1 profile-metrics">
            <div :if={@preview} class="col text-center" id="profile-registration-age">
              <% {age, unit} = registration_age(@player) %>
              <strong>{age} <span class="profile-age-unit">{unit}</span></strong>
              <span class="profile-metric-label">
                <%= cond do %>
                  <% @player.bot_options -> %>
                    A.I. Player
                  <% @player.user -> %>
                    Registered
                  <% true -> %>
                    Joined
                <% end %>
              </span>
            </div>
            <div class="col text-center">
              <strong title="Arena Rating" data-toggle="tooltip">
                <i class="ui-icon ui-focus text-white"></i> {@player.pvp_points} AR
              </strong>
              <span :if={@preview} class="profile-metric-label">Arena Rating</span>
            </div>
            <div class="col text-center">
              <strong
                id="profile-3v3-win-rate"
                title={GH.win_rate_summary(@recent_results)}
                data-toggle="tooltip"
              >
                <i class="ui-icon ui-swords text-white"></i> {GH.win_rate(@recent_results)}%
              </strong>
              <span :if={@preview} class="profile-metric-label">3v3 Win Rate</span>
            </div>
            <div class="col text-center">
              <strong
                title={"Current Immortal Streak: #{@player.current_immortal_streak}<br/>Best Immortal Streak: #{@player.best_immortal_streak}"}
                data-toggle="tooltip"
              >
                <i class="ui-icon ui-trophy text-white"></i> {@player.best_immortal_streak}
              </strong>
              <span :if={@preview} class="profile-metric-label">Best Immortal Streak</span>
            </div>
            <div class="col text-center">
              <strong title="Season Rank" data-toggle="tooltip">
                <i class="ui-icon ui-hashtag text-white"></i> {@player.season_ranking}
              </strong>
              <span :if={@preview} class="profile-metric-label">Season rank</span>
            </div>
          </div>
          <div :if={@duels != []} class="profile-history-switcher">
            <div class="profile-ranking-switch profile-history-tabs" role="group" aria-label="Battle history mode">
              <button
                :for={{tab, label, icon} <- [{"matches", "3v3", "game-arena-3v3"}, {"duels", "1v1", "game-swords"}]}
                type="button"
                id={"#{tab}-btn"}
                phx-click={if @filter != tab, do: "show-#{tab}"}
                aria-pressed={to_string(@filter == tab)}
              >
                <.icon name={icon} /> {label}
              </button>
            </div>
          </div>

          <.arena_debut :if={@preview && @arena_debut} {assigns} />

          <%= if !@preview || is_nil(@arena_debut) do %>
            <.duel_record
              :if={@filter == "duels" && @current_player.user && @player.user && @player.id != @current_player.id}
              {assigns}
            />

            <div class="profile-history">
              <p :if={@filter == "matches" && @matches == []} class="profile-rank-empty">
                No completed 3v3 matches yet.
              </p>
              <table
                :if={@filter == "duels" || @matches != []}
                id={"profile-#{@filter}-table"}
                class="profile-history-table"
              >
                <colgroup>
                  <col />
                  <col class="profile-history-result-column" />
                  <col class="profile-history-replay-column" />
                </colgroup>
                <thead class="sr-only">
                  <tr>
                    <th scope="col">Opponent</th>
                    <th scope="col">Result</th>
                    <th scope="col">Replay</th>
                  </tr>
                </thead>
                <tbody>
                  <%= if @filter == "matches" do %>
                    <.history_row
                      :for={match <- @matches}
                      opponent={match.opponent}
                      mode={"#{String.capitalize(match.type)} match"}
                      result={if match.winner_id == @player.id, do: "Victory", else: "Defeat"}
                      rating={match.rewards.attacker_pvp_points}
                      replay_path={preview_path(assigns, ~p"/matches/#{match}")}
                      replay_label={"Review match #{match.id}"}
                      preview={@preview}
                    />
                  <% else %>
                    <.history_row
                      :for={duel <- @duels}
                      opponent={opponent_for(duel, @player)}
                      mode={GH.duel_mode_label(duel)}
                      result={history_result(duel.winner_player_id, @player.id)}
                      rating={duel_rating(duel, @player.id)}
                      replay_path={preview_path(assigns, ~p"/arena/#{duel}")}
                      replay_label={"Review duel #{duel.id}"}
                      preview={@preview}
                    />
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

          <div :if={!@preview || @player.id == @current_player.id} class="card-footer p-1">
            <nav
              :if={@preview && @player.id == @current_player.id}
              id="profile-actions"
              class="profile-actions"
              aria-label="Account actions"
            >
              <.link navigate={preview_path(assigns, ~p"/users/settings")}>
                <i class="ui-icon ui-edit mr-1"></i>Edit Profile
              </.link>
              <.link href="/auth/discord" class="profile-action-discord">
                <i class="ui-icon ui-chat-controller"></i> Connect Discord
              </.link>
              <.link href={preview_path(assigns, ~p"/users/log_out")} method="delete" class="profile-action-logout">
                <i class="ui-icon ui-sign-out mr-1"></i>Log out
              </.link>
            </nav>
            <div :if={!@preview} class="row">
              <div class="col text-center">
                <span class="font-italic text-dark">
                  {registered_label(@player)}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-xl-4 profile-ranking-column">
        <div class="card ranking" phx-hook="EqualHeight" phx-target=".collection-container" id="user-ranking">
          <div class="card-body" id="ranking-card">
            <div :if={@preview} id="profile-ranking-header" class="profile-ranking-header">
              <div class="profile-ranking-title">
                <.icon name="game-trophy" />
                <div>
                  <strong>Leaderboard</strong>
                  <span
                    data-toggle={if @ranking_tab == "season", do: "tooltip"}
                    title={if @ranking_tab == "season", do: TT.season_score_tooltip(@player)}
                    tabindex={if @ranking_tab == "season", do: "0"}
                  >
                    {case @ranking_tab do
                      "season" -> "Season score"
                      "team" -> "Top 50 teams"
                      "hero" -> "Top 200 heroes"
                    end}
                  </span>
                </div>
              </div>
              <div class="profile-ranking-switch profile-leaderboard-switch" role="group" aria-label="Leaderboard type">
                <button
                  :for={{tab, label} <- [{"season", "Season"}, {"team", "Team"}, {"hero", "Hero"}]}
                  id={"profile-ranking-#{tab}"}
                  type="button"
                  phx-click="profile-ranking"
                  phx-value-type={tab}
                  aria-pressed={to_string(@ranking_tab == tab)}
                >
                  {label}
                </button>
              </div>
            </div>
            <.season_ranking :if={@ranking_tab == "season"} {assigns} />
            <.team_ranking :if={@ranking_tab == "team"} {assigns} />
            <.hero_ranking :if={@ranking_tab == "hero"} {assigns} />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
