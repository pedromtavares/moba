<Layouts.app
  preview={@preview}
  flash={@flash}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code={@sidebar_code}
>
  <div class="user-profile">
    <.cinematic_header :if={@preview} {assigns} />
    <div class="row mt-2 profile-board">
      <div class="col-md-6 col-xl-4 profile-collection-column">
        <div class="collection-container" id="profile-collection">
          <.featured_hero_card preview={Map.get(assigns, :preview, false)} :if={@featured && !@preview} hero={@featured} />
          <div class="card collection mb-0">
            <div class="card-body pb-1 d-flex">
              <div class="row">
                <%= for hero <- @player.hero_collection do %>
                  <div class="col-3 text-center">
                    <a
                      href="javascript:;"
                      class={if @featured.id == hero["hero_id"], do: "current-featured"}
                      phx-click="set-featured"
                      phx-value-id={hero["hero_id"]}
                      phx-hook="Loading"
                      id={"set-featured-#{hero["hero_id"]}"}
                    >
                      <div class="avatar-container">
                        <img src={GH.image_url(hero["avatar"])} class={avatar_class(hero)} />
                        <.league_badge tier={hero["tier"]} variant="legacy" />
                      </div>
                    </a>
                  </div>
                <% end %>
                <%= for avatar <- @blank_collection do %>
                  <div class="col-3 text-center">
                    <div class="avatar-container">
                      <img src={GH.image_url(avatar)} class="avatar blank-avatar" />
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-4 profile-record-column">
        <div class="card" phx-hook="EqualHeight" phx-target=".collection-container" id="user-profile">
          <%= if !@preview && @player.id == @current_player.id do %>
            <h5 class="card-header font-17 text-white d-flex justify-content-between py-2">
              <.link navigate={preview_path(assigns, ~p"/users/settings")} class="text-white">
                <i class="ui-icon ui-edit mr-1"></i>Edit Profile
              </.link>
              <.link href="/auth/discord" class="text-white">
                <i class="ui-icon ui-chat-controller"></i> Connect Discord
              </.link>
              <.link href={preview_path(assigns, ~p"/users/log_out")} method="delete" class="text-white">
                <i class="ui-icon ui-sign-out"></i>
                <span class="d-none d-md-inline">Log out</span>
              </.link>
            </h5>
          <% end %>
          <div :if={!@preview} class="card-body p-2 text-center">
            <img
              src={"/images/pve/#{@player.pve_tier}.png"}
              class={"pvp-rank big-rank-shadow-#{shadow_rank(@player)}"}
              data-toggle="tooltip"
              title={"#{Moba.pve_tiers[@player.pve_tier]} (#{@player.pve_tier})"}
            />
            <h2 class="text-white f-rpg">
              <span class={"name-shadow-#{shadow_rank(@player)}"}>
                <%= if @player.user.discord.id do %>
                  <img
                    src={@player.user.discord.avatar}
                    class="discord-avatar"
                    data-toggle="tooltip"
                    title={"Discord: #{@player.user.discord.nickname}"}
                  />
                <% end %>
                {username(@player)}
              </span>
            </h2>
          </div>
          <hr />
          <div :if={!@preview} class="row no-gutters py-1 profile-metrics">
            <div :if={@preview} class="col text-center" id="profile-registration-age">
              <% {age, unit} = registration_age(@player) %>
              <strong>{age} <span class="profile-age-unit">{unit}</span></strong>
              <span class="profile-metric-label">
                <%= cond do %>
                  <% @player.bot_options -> %>A.I. Player
                  <% @player.user -> %>Registered
                  <% true -> %>Joined
                <% end %>
              </span>
            </div>
            <div class="col text-center">
              <strong title="Season Points" data-toggle="tooltip">
                <i class="ui-icon ui-focus text-white"></i> {@player.pvp_points} SP
              </strong>
              <span :if={@preview} class="profile-metric-label">Season points</span>
            </div>
            <div class="col text-center">
              <strong
                title={"5v5 Win Rate: #{total_win_rate(@player)}<br/>Total Matches: #{@player.total_matches}<br/>Total Wins: #{@player.total_wins}"}
                data-toggle="tooltip"
              >
                <i class="ui-icon ui-swords text-white"></i> {total_win_rate(@player)}
              </strong>
              <span :if={@preview} class="profile-metric-label">5v5 Win Rate</span>
            </div>
            <div class="col text-center">
              <strong
                title={"Current Immortal Streak: #{@player.current_immortal_streak}<br/>Best Immortal Streak: #{@player.best_immortal_streak}"}
                data-toggle="tooltip"
              >
                <i class="ui-icon ui-trophy text-white"></i> {@player.best_immortal_streak}
              </strong>
              <span :if={@preview} class="profile-metric-label">Best Immortal Streak</span>
            </div>
            <div class="col text-center">
              <strong title="Season Rank" data-toggle="tooltip">
                <i class="ui-icon ui-hashtag text-white"></i> {@player.season_ranking}
              </strong>
              <span :if={@preview} class="profile-metric-label">Season rank</span>
            </div>
          </div>
          <%= if length(@duels) > 0 do %>
            <hr />
            <div class="row">
              <div class="col d-flex justify-content-center">
                <div class="pt-2 pb-2 profile-history-switcher">
                  <div class="btn-group profile-history-tabs">
                    <%= if @filter == "matches" do %>
                      <button type="button" class="btn btn-sm btn-secondary no-action">
                        <span class="loading-text">5v5</span>
                      </button>
                      <button
                        type="button"
                        class="btn btn-sm btn-light"
                        phx-click="show-duels"
                        phx-hook="Loading"
                        id="duels-btn"
                      >
                        <span class="loading-text">1v1</span>
                      </button>
                    <% else %>
                      <button
                        type="button"
                        class="btn btn-sm btn-light"
                        phx-click="show-matches"
                        phx-hook="Loading"
                        id="matches-btn"
                      >
                        <span class="loading-text">5v5</span>
                      </button>
                      <button type="button" class="btn btn-sm btn-secondary no-action">
                        <span class="loading-text">1v1</span>
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <.arena_debut :if={@preview && @arena_debut} {assigns} />

          <%= if @filter == "matches" && (!@preview || is_nil(@arena_debut)) do %>
            <div class="row">
              <div class="col">
                <div class="transparent p-0 matches profile-history">
                  <table class="table table-dark text-center table-sm m-0 history-table" id="profile-matches-table">
                    <%= for match <- @matches do %>
                      <tr>
                        <td class="text-center" width="33%">
                          <span class="opponent">
                            <.link navigate={preview_path(assigns, ~p"/player/#{match.opponent_id}")}>
                              {username(match.opponent)}
                            </.link>
                            <small :if={@preview} class="history-detail">{String.capitalize(match.type)} match</small>
                          </span>
                        </td>

                        <td class="text-center" width="33%">
                          <.match_result match={match} />
                          <.rewards_badge rewards={match.rewards.attacker_pvp_points} />
                        </td>

                        <td class="text-center" width="33%">
                          <.link
                            navigate={preview_path(assigns, ~p"/matches/#{match}")}
                            class="btn btn-light btn-sm game-review"
                            aria-label={"Review match #{match.id}"}
                            data-toggle="tooltip"
                            title={String.capitalize(match.type)}
                          >
                            <i class="ui-icon ui-eye"></i>
                          </.link>
                        </td>
                      </tr>
                    <% end %>
                  </table>
                </div>
              </div>
            </div>
          <% end %>

          <%= if @filter == "duels" && (!@preview || is_nil(@arena_debut)) do %>
            <%= if @current_player.user && @player.user && @player.id != @current_player.id do %>
              <div class="border-top pt-1">
                <div class="row no-gutters">
                  <div class="col">
                    <h4 class="text-right">
                      {username(@current_player)}
                      <span class="badge badge-pill badge-light-danger font-15">
                        {@current_player.duel_score["#{@player.id}"] || 0}
                      </span>
                    </h4>
                  </div>
                  <div class="col-1 d-flex align-items-center justify-content-center">
                    <i class="ui-icon ui-close"></i>
                  </div>
                  <div class="col">
                    <h4 class="text-left">
                      <span class="badge badge-pill badge-light-danger font-15">
                        {@player.duel_score["#{@current_player.id}"] || 0}
                      </span>
                      {username(@player)}
                    </h4>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="transparent p-0 duels profile-history">
              <table class="table table-dark text-center table-sm m-0 history-table" id="profile-duels-table">
                <%= for duel <- @duels do %>
                  <tr>
                    <td class="text-center">
                      <span class="opponent">
                        <.link navigate={preview_path(assigns, ~p"/player/#{opponent_for(duel, @player).id}")}>
                          {duel |> opponent_for(@player) |> username()}
                        </.link>
                        <small :if={@preview} class="history-detail">{GH.duel_mode_label(duel)}</small>
                      </span>
                    </td>

                    <td class="text-center">
                      <.duel_result duel={duel} player_id={@player.id} />
                      <%= if duel.player_id == @player.id do %>
                        <.rewards_badge rewards={duel.rewards.attacker_pvp_points} />
                      <% else %>
                        <.rewards_badge rewards={duel.rewards.defender_pvp_points} />
                      <% end %>
                    </td>

                    <td>
                      <.link navigate={preview_path(assigns, ~p"/arena/#{duel}")} class="btn btn-light btn-sm game-review" aria-label={"Review duel #{duel.id}"}>
                        <i class="ui-icon ui-eye"></i>
                      </.link>
                    </td>
                  </tr>
                <% end %>
              </table>
            </div>
          <% end %>

          <div :if={!@preview || @player.id == @current_player.id} class="card-footer p-1">
            <nav :if={@preview && @player.id == @current_player.id} id="profile-actions" class="profile-actions" aria-label="Account actions">
              <.link navigate={preview_path(assigns, ~p"/users/settings")}>
                <i class="ui-icon ui-edit mr-1"></i>Edit Profile
              </.link>
              <.link href="/auth/discord" class="profile-action-discord">
                <i class="ui-icon ui-chat-controller"></i> Connect Discord
              </.link>
              <.link href={preview_path(assigns, ~p"/users/log_out")} method="delete" class="profile-action-logout">
                <i class="ui-icon ui-sign-out mr-1"></i>Log out
              </.link>
            </nav>
            <div :if={!@preview} class="row">
              <div class="col text-center">
                <span class="font-italic text-dark">
                  {registered_label(@player)}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12 col-xl-4 profile-ranking-column">
        <div class="card ranking" phx-hook="EqualHeight" phx-target=".collection-container" id="user-ranking">
          <div class="card-body" id="ranking-card">
            <div :if={@preview} id="profile-ranking-header" class="profile-ranking-header">
              <div class="profile-ranking-title">
                <.icon name="game-trophy" />
                <div>
                  <strong>Leaderboard</strong>
                  <span>{if @ranking_tab == "season", do: "Season score", else: "Top 200 heroes"}</span>
                </div>
              </div>
              <div class="profile-ranking-switch" role="group" aria-label="Leaderboard type">
                <button :for={{tab, label} <- [{"season", "Season Rank"}, {"hero", "Hero Rank"}]} id={"profile-ranking-#{tab}"} type="button" phx-click="profile-ranking" phx-value-type={tab} aria-pressed={to_string(@ranking_tab == tab)}>
                  {label}
                </button>
              </div>
            </div>
            <.season_ranking :if={@ranking_tab == "season"} {assigns} />
            <.hero_ranking :if={@ranking_tab == "hero"} {assigns} />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
