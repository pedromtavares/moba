<div class={if !@preview, do: "pt-3"}>
  <div id="base-collection" class="collection" aria-label="Hero collection" role="group">
    <%= for hero <- (@current_player.hero_collection || []) do %>
      <% undefeated = GH.perfect_collection_run?(hero) %>
      <% name = hero["avatar"]["name"] %>
      <button
        id={"base-avatar-#{hero["code"]}"}
        type="button"
        style="width: 100px;"
        class={["avatar-container text-center mx-1", undefeated && "is-undefeated"]}
        data-nav-loading="spinner"
        phx-click="browse-avatar"
        phx-value-code={hero["code"]}
        aria-pressed={to_string(@selected_avatar != nil && @selected_avatar.code == hero["code"])}
        data-toggle="tooltip"
        title={if undefeated, do: "#{name} · Perfect Run", else: name}
      >
        <img
          src={GH.image_url(hero["avatar"])}
          class="avatar"
          alt={if undefeated, do: "#{name}, Perfect Run", else: name}
        />
        <.league_badge tier={hero["tier"]} variant="legacy" />
      </button>
    <% end %>
    <%= for avatar <- @blank_collection do %>
      <% locked = !avatar_unlocked?(avatar, @unlocked_codes) %>
      <button
        id={"base-avatar-#{avatar.code}"}
        type="button"
        style="width:100px;height:75px"
        class="avatar-container text-center mx-1"
        data-nav-loading="spinner"
        phx-click="browse-avatar"
        phx-value-code={avatar.code}
        aria-pressed={to_string(@selected_avatar != nil && @selected_avatar.code == avatar.code)}
        aria-label={if locked, do: "#{avatar.name}, locked", else: avatar.name}
        data-toggle="tooltip"
        title={avatar.name}
      >
        <img
          src={GH.image_url(avatar)}
          class="avatar blank-avatar"
          alt=""
        />
        <i :if={locked} class="ui-icon ui-lock base-avatar-lock" aria-hidden="true"></i>
      </button>
    <% end %>
  </div>
</div>
