<% next = next_pve_tier(@current_player) %>
<section
  id="pve-progression"
  class="base-ascent"
  style="--base-ascent-scene: url(/images/tutorial/hall-of-legends.jpg)"
  aria-labelledby="base-ascent-title"
>
  <div class="base-ascent-heading">
    <h2 id="base-ascent-title">
      <%= if next do %>
        Path to <span>Invoker</span>
      <% else %>
        <span>Invoker</span>
      <% end %>
    </h2>
    <div :if={next} class="base-ascent-milestone">
      <div class="base-ascent-mobile-ranks" aria-hidden="true">
        {Moba.pve_tiers()[@current_player.pve_tier]} → {Moba.pve_tiers()[next]}
      </div>
      <p id="base-quest-description">{current_quest_description(@current_player)}</p>
      <div class="base-ascent-milestone-values">
        <strong
          id="base-rank-progress"
          role="progressbar"
          aria-labelledby="base-quest-description"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={quest_progression_pct(@current_player)}
          aria-valuetext={quest_progression_label(@current_player)}
          title={quest_avatars_title(@current_player)}
        >
          {quest_progression_label(@current_player)}
        </strong>
        <span class="base-ascent-prize" title="Reward on rank up">
          <span aria-hidden="true">◆</span> +{Game.get_quest(next).prize} Shards
        </span>
      </div>
    </div>
    <p :if={!next} id="base-ascent-complete">The highest rank is yours.</p>
    <button
      :if={next && @current_player.pvp_tier != Moba.max_pvp_tier()}
      id="base-rewards-btn"
      type="button"
      class="btn base-ascent-rewards"
      data-toggle="modal"
      data-target="#pve-tier-rewards"
    >
      Progression rewards <span aria-hidden="true">→</span>
    </button>
  </div>
  <ol class="base-ascent-track" aria-label="Player rank progression">
    <li
      :for={tier <- 0..Moba.max_pve_tier()}
      id={"base-rank-#{tier}"}
      class={[
        "base-ascent-rank",
        tier < @current_player.pve_tier && "is-complete",
        tier == @current_player.pve_tier && "is-current",
        tier == next && "is-next"
      ]}
      style={if tier == next, do: "--rank-progress: #{quest_progression_pct(@current_player) / 100}"}
      aria-current={if tier == @current_player.pve_tier, do: "step"}
    >
      <div class="base-ascent-emblem">
        <img src={"/images/pve/#{tier}.png"} alt="" />
      </div>
      <strong>{Moba.pve_tiers()[tier]}</strong>
      <small :if={tier == @current_player.pve_tier}>Current rank</small>
      <small :if={tier == next}>Next rank</small>
    </li>
  </ol>
  <footer class="base-ascent-footer">
    <.hero_collection {assigns} />
  </footer>
</section>
