<div
  class="shop cinematic-shop"
  id={GH.dom_id(@id_prefix, "shop")}
  data-selected-code={@selected_shop && @selected_shop.code}
  data-item-inspected={to_string(@item_inspected)}
  data-selected-rarity={@selected_shop && @selected_shop.rarity}
  data-recipe-rarity={@transmute && Game.previous_item_rarity(@transmute)}
  data-recipe-count={@transmute && ingredients_count_for(@transmute)}
>
  <img class="shop-backdrop" src={GH.background_url(@current_hero)} alt="" aria-hidden="true" />
  <header class="shop-heading">
    <div class="shop-heading-copy">
      <h2 id={GH.dom_id(@id_prefix, "shop-title")}>Shop<span class="shop-heading-rule"></span></h2>
    </div>
    <p class="shop-keyboard-hint" aria-label="Use arrow keys to browse and Space for the selected action">
      <kbd>←</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd> Browse <span></span><kbd>SPACE</kbd> Action
    </p>
    <div class="shop-wallet" aria-label={"#{@current_hero.gold} gold available"}>
      <i class="ui-icon ui-coins" aria-hidden="true"></i>
      <strong id={GH.dom_id(@id_prefix, "shop-gold")}>{@current_hero.gold}</strong><span>gold</span>
    </div>
    <button
      type="button"
      aria-label="Close shop"
      data-close-on-escape
      id={GH.dom_id(@id_prefix, "close-button")}
      phx-click="close-shop"
      {target_attrs(@event_target, @hero_id)}
    >
      <i class="ui-icon ui-close" aria-hidden="true"></i>
    </button>
  </header>

  <div class="shop-workspace">
    <nav class="shop-shelves" aria-label="Shop rarities and inventory">
      <section
        id={GH.dom_id(@id_prefix, "inventory")}
        class={["shop-shelf shop-inventory", @selected_category == "inventory" && "is-current"]}
        data-rarity="inventory"
      >
        <button
          type="button"
          id={GH.dom_id(@id_prefix, "shop-category-inventory")}
          class="shop-shelf-label"
          phx-click="select-category"
          phx-value-rarity="inventory"
          phx-target={@myself}
          aria-pressed={to_string(@selected_category == "inventory")}
        >
          <span>Inventory</span><small>{length(@current_hero.items)} / 6 slots</small>
        </button>
        <div
          class="shop-miniatures"
          id={GH.dom_id(@id_prefix, "shop-inventory-order")}
          phx-hook="InventoryOrder"
          data-inventory-order="true"
          data-hero-id={@current_hero.id}
          data-reorderable={to_string(@reorderable)}
          data-order-status={GH.dom_id(@id_prefix, "shop-inventory-status")}
          role="group"
          aria-label="Inventory items"
        >
          <button
            :for={item <- Game.inventory_items(@current_hero)}
            type="button"
            id={GH.dom_id(@id_prefix, "transmute-#{item.id}")}
            class={[
              "shop-tile inventory-item",
              !can_select_inventory(item, @transmute, @recipe) && "is-unavailable",
              ((@selected_inventory && @selected_inventory.code == item.code) || item in @recipe) && "is-selected"
            ]}
            aria-label={item.name}
            aria-pressed={
              to_string((@selected_inventory && @selected_inventory.code == item.code) || item in @recipe || false)
            }
            disabled={!@reorderable && !can_select_inventory(item, @transmute, @recipe)}
            aria-disabled={to_string(!can_select_inventory(item, @transmute, @recipe))}
            aria-keyshortcuts={@reorderable && "Alt+ArrowLeft Alt+ArrowRight Alt+ArrowUp Alt+ArrowDown"}
            data-item-code={item.code}
            data-item-name={item.name}
            phx-click="select-inventory"
            phx-value-code={item.code}
            data-rarity={item.rarity}
            phx-target={@myself}
          >
            <img
              src={GH.image_url(item)}
              alt=""
              class="tooltip-mobile"
              data-toggle="tooltip"
              title={TT.item_tooltip(item)}
              draggable="false"
            />
            <span :if={item in @recipe} class="shop-owned" aria-label="Ingredient selected">✓</span>
          </button>
          <div
            :for={_ <- List.duplicate(nil, max(0, 6 - length(@current_hero.items)))}
            class="shop-empty-slot"
            aria-label="Empty inventory slot"
          >
            <span>+</span>
          </div>
        </div>
        <span
          id={GH.dom_id(@id_prefix, "shop-inventory-status")}
          class="sr-only"
          role="status"
          aria-live="polite"
          phx-update="ignore"
        >
        </span>
      </section>

      <Shop.shelf
        :for={rarity <- categories()}
        rarity={rarity}
        items={rarity_filter(@items, rarity)}
        selected_category={@selected_category}
        selected_item={@selected_shop}
        owned_items={@current_hero.items}
        id_prefix={@id_prefix}
        event_target={@myself}
      />
    </nav>

    <section
      id={GH.dom_id(@id_prefix, "shop-detail")}
      class="shop-detail"
      data-rarity={@detail_item && @detail_item.rarity}
      aria-label="Selected item details"
    >
      <%= if @detail_item do %>
        <Shop.item_showcase item={@detail_item} id_prefix={@id_prefix} transmuting={not is_nil(@transmute)} />

        <div class="shop-item-description" data-detail-tab={@detail_tab}>
          <div class="shop-inspect-tabs" aria-label="Item information">
            <button
              :for={{tab, label} <- [{"overview", "Overview"}, {"effects", "Effects"}]}
              type="button"
              phx-click="inspect-tab"
              phx-value-tab={tab}
              phx-target={@myself}
              aria-pressed={to_string(@detail_tab == tab)}
            >
              {label}
            </button>
          </div>
          <div id={GH.dom_id(@id_prefix, "shop-detail-description")} class="shop-tooltip-readout">
            <MobaWeb.V2.Components.ItemTooltip.card item={@detail_item} show_heading={false} />
          </div>
        </div>

        <div class="shop-detail-bottom">
          <%= cond do %>
            <% @transmute -> %>
              <div class="shop-recipe">
                <p id={GH.dom_id(@id_prefix, "transmute-instructions")}>{transmute_instructions_for(@transmute)}</p>
                <div class="shop-recipe-slots">
                  <img
                    :for={item <- @recipe}
                    src={GH.image_url(item)}
                    alt={item.name}
                    id={GH.dom_id(@id_prefix, "recipe-#{item.id}")}
                  />
                  <div
                    :for={_ <- List.duplicate(nil, max(0, ingredients_count_for(@transmute) - length(@recipe)))}
                    class="shop-empty-slot"
                  >
                    <span>+</span>
                  </div>
                  <span class="shop-recipe-arrow" aria-hidden="true">→</span>
                  <img src={GH.image_url(@transmute)} alt={@transmute.name} />
                </div>
              </div>
              <div class="shop-detail-actions">
                <.form
                  for={to_form(%{}, as: :transmute)}
                  id={GH.dom_id(@id_prefix, "shop-transmute-form")}
                  phx-submit="finish-transmute"
                  {target_attrs(@event_target, @hero_id)}
                >
                  <input type="hidden" name="transmute_code" value={@transmute.code} />
                  <input :for={item <- @recipe} type="hidden" name="recipe_codes[]" value={item.code} />
                  <button
                    type="submit"
                    class="shop-primary"
                    disabled={!proper_recipe(@recipe, @transmute)}
                    id={GH.dom_id(@id_prefix, "finish-transmute")}
                    data-acquire-code={@transmute.code}
                    data-hero-id={@current_hero.id}
                  >
                    <span class="loading-text"><i class="ui-icon ui-refresh" aria-hidden="true"></i> Transmute</span>
                  </button>
                </.form>
                <button
                  type="button"
                  class="shop-secondary"
                  phx-click="cancel-transmute"
                  id={GH.dom_id(@id_prefix, "cancel-transmute")}
                  phx-target={@myself}
                >
                  Cancel
                </button>
              </div>
            <% @selected_inventory -> %>
              <p class="shop-action-hint">Sell this item to free an inventory slot.</p>
              <button
                type="button"
                class="shop-secondary shop-sell"
                phx-click="sell"
                phx-value-code={@selected_inventory.code}
                id={GH.dom_id(@id_prefix, "sell-#{@selected_inventory.id}")}
                {target_attrs(@event_target, @hero_id)}
              >
                Sell for
                <i class="ui-icon ui-coins" aria-hidden="true"></i> {Game.item_sell_price(
                  @current_hero,
                  @selected_inventory
                )}
              </button>
            <% true -> %>
              <p
                :if={purchase_hint(@current_hero, @selected_shop)}
                class="shop-action-hint"
                id={GH.dom_id(@id_prefix, "shop-purchase-hint")}
              >
                {purchase_hint(@current_hero, @selected_shop)}
              </p>
              <div class="shop-detail-actions">
                <button
                  type="button"
                  class="shop-primary buy-button"
                  phx-click="buy"
                  phx-value-code={@selected_shop.code}
                  disabled={!can_buy?(@current_hero, @selected_shop)}
                  id={GH.dom_id(@id_prefix, "buy-button")}
                  data-acquire-code={@selected_shop.code}
                  data-hero-id={@current_hero.id}
                  {target_attrs(@event_target, @hero_id)}
                >
                  <span class="loading-text">
                    <%= if can_equip?(@current_hero, @selected_shop) do %>
                      Buy <i class="ui-icon ui-coins" aria-hidden="true"></i> {price(@selected_shop)}
                    <% else %>
                      Already in your inventory
                    <% end %>
                  </span>
                </button>
                <button
                  :if={@selected_shop.rarity != "normal"}
                  type="button"
                  class="shop-secondary transmute-button"
                  phx-click="start-transmute"
                  phx-target={@myself}
                  disabled={!can_transmute?(@current_hero, @selected_shop)}
                  id={GH.dom_id(@id_prefix, "start-transmute")}
                >
                  <i class="ui-icon ui-refresh" aria-hidden="true"></i> Transmute
                </button>
              </div>
              <p :if={@selected_shop.rarity != "normal"} class="shop-recipe-hint">
                Or combine {ingredients_count_for(@selected_shop)} {String.capitalize(
                  Game.previous_item_rarity(@selected_shop)
                )} items. No gold required.
              </p>
          <% end %>
        </div>
      <% else %>
        <div class="shop-empty-inventory">
          <img src="/images/navigation/tavern.webp" alt="" />
          <span class="shop-eyebrow">Your build starts here</span>
          <h3>Six slots.<br />Endless possibilities.</h3>
          <p>Choose an item from the shelves to start building your advantage.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
