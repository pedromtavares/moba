<div id="hero-detail" class="hero-detail">
  <div class="hero-detail-overview">
    <article class="hero-card card hero-detail-card" id="hero-detail-card" aria-labelledby="hero-detail-name">
      <div class="card-header">
        <div class="hero-detail-identity">
          <div>
            <h2 id="hero-detail-name">{@hero.name}</h2>
            <span class="hero-detail-avatar-name">{@hero.avatar.name}</span>
          </div>
          <div class="hero-detail-level"><span>Level</span><strong>{@hero.level}</strong></div>
        </div>
      </div>
      <div class="card-body">
        <img src={GH.background_url(@hero)} alt={@hero.avatar.name} />
      </div>
      <div class="card-footer">
        <div id="hero-detail-stats" class="hero-detail-stats"><.hero_stats_buttons hero={@hero} /></div>
        <div class="row">
          <div class="col-12 hero-detail-loadout" id="hero-detail-loadout">
            <.hero_skill_strip skills={@hero.skills} id_prefix="skill" id_suffix={@hero.id} />
            <.hero_item_strip items={Game.sort_items(@hero.items)} id_prefix="item" id_suffix={@hero.id} />
          </div>
        </div>
        <nav :if={@hero.player.user_id || @hero.player_id == @current_player.id} class="hero-detail-actions" aria-label="Hero actions">
          <.link :if={@hero.player.user_id} id="hero-detail-player" navigate={preview_path(assigns, ~p"/player/#{@hero.player_id}")}>
            Player profile <span aria-hidden="true">→</span>
          </.link>
          <button
            :if={@hero.player_id == @current_player.id}
            id="customize-hero"
            type="button"
            phx-click="toggle-customize"
            aria-expanded={to_string(@show_hud)}
            aria-controls="hero-bar"
          >
            {if @show_hud, do: "Close customization", else: "Customize hero"}
          </button>
          <%= if @hero.player_id == @current_player.id && @skin_selection do %>
            <div class="hero-detail-skins" id="hero-detail-skins">
              <button
                :if={has_previous_skin?(@skin_selection)}
                id="hero-previous-skin"
                type="button"
                phx-click="set-skin"
                phx-value-skin-code={previous_skin_for(@skin_selection)}
                aria-label="Previous skin"
              >
                ←
              </button>
              <.link id="hero-view-skins" navigate={preview_path(assigns, ~p"/tavern?#{%{avatar: @hero.avatar.code}}")}>
                View skins
              </.link>
              <button
                :if={has_next_skin?(@skin_selection)}
                id="hero-next-skin"
                type="button"
                phx-click="set-skin"
                phx-value-skin-code={next_skin_for(@skin_selection)}
                aria-label="Next skin"
              >
                →
              </button>
            </div>
          <% end %>
        </nav>
      </div>
    </article>
  </div>

  <section id="hero-detail-performance" class="hero-detail-performance" aria-labelledby="hero-league-title">
    <div class="hero-detail-section-heading">
      <h2 id="hero-league-title">{Moba.leagues()[@hero.league_tier]}</h2>
      <span id="hero-training-status" data-finished={to_string(!is_nil(@hero.finished_at))}>
        {if @hero.finished_at, do: "Complete", else: "In training"}
      </span>
    </div>
    <ol class="hero-league-path" aria-label="League progression">
      <li
        :for={{tier, name} <- Enum.sort(Moba.leagues())}
        class={tier_class(tier, @hero.league_tier)}
        aria-current={if tier == @hero.league_tier, do: "step"}
        title={name}
      >
        <img src={"/images/league/#{tier}.png"} alt={name} />
      </li>
    </ol>
    <dl class="hero-detail-metrics">
      <div>
        <dt>Total farm</dt>
        <dd class="hero-farm-total" title={@hero.total_xp_farm + @hero.total_gold_farm}>
          {GH.farming_amount_label(@hero.total_xp_farm + @hero.total_gold_farm)}
        </dd>
      </div>
      <div>
        <dt>XP farm</dt>
        <dd class="hero-farm-xp" title={@hero.total_xp_farm}>{GH.farming_amount_label(@hero.total_xp_farm)}</dd>
      </div>
      <div>
        <dt>Gold farm</dt>
        <dd class="hero-farm-gold" title={@hero.total_gold_farm}>{GH.farming_amount_label(@hero.total_gold_farm)}</dd>
      </div>
      <div id="hero-detail-duration">
        <%= if @hero.finished_at do %>
          <dt>Training time</dt>
          <dd>{GH.minutes_label(GH.finished_time(@hero), true)} <small>min</small></dd>
        <% else %>
          <dt>Turns left</dt>
          <dd>{@hero.pve_total_turns + @hero.pve_current_turns}</dd>
        <% end %>
      </div>
    </dl>
  </section>

  <section id="hero-leaderboard" class="hero-leaderboard" aria-labelledby="hero-leaderboard-title">
    <div id="hero-ranking-switcher" class="hero-ranking-switcher" role="group" aria-label="Training rankings">
      <button
        :for={{tab, label} <- [{"league", "League Ranking"}, {"global", "Global Ranking"}]}
        id={"hero-ranking-#{tab}-tab"}
        type="button"
        phx-click="ranking-tab"
        phx-value-type={tab}
        aria-pressed={to_string(@ranking_tab == tab)}
        aria-controls="ranking-card"
        disabled={tab == "league" && @hero.league_tier < 2}
      >{label}</button>
    </div>
    <header class="hero-leaderboard-heading">
      <%= if @ranking_tab == "league" do %>
        <img src={"/images/league/#{@hero.league_tier}.png"} alt="" />
      <% else %>
        <.icon name="game-trophy" />
      <% end %>
      <div>
        <h2 id="hero-leaderboard-title">{if @ranking_tab == "league", do: Moba.leagues()[@hero.league_tier] <> " rankings", else: "Global rankings"}</h2>
        <p>{if @ranking_tab == "league", do: "All-time completed runs", else: "Top #{Moba.pve_ranking_limit()} training runs"}</p>
      </div>
      <span id="hero-ranking-standing" :if={@leaderboard_position}>
        <strong>#{@leaderboard_position}</strong>
        <small><%= if @ranking_tab == "league" do %>of {@league_ranking.total} {if @league_ranking.total == 1, do: "run", else: "runs"}<% else %>Global rank<% end %></small>
      </span>
    </header>
    <p :if={@hero.league_tier < 2} id="hero-ranking-minimum-league" class="hero-league-placement">League rankings begin at Gold. Keep climbing to earn your place.</p>
    <p :if={!@hero.finished_at && @hero.league_tier >= 2} id="hero-league-placement" class="hero-league-placement">Finish training to earn your place in the standings.</p>
    <p :if={@ranking_tab == "global" && @hero.finished_at && !@leaderboard_position} id="hero-global-placement" class="hero-league-placement">This run has no global rank. All completed runs from Gold onward have a league ranking.</p>
    <div id="ranking-card" class="hero-ranking-scroll" tabindex="0" role="region" aria-labelledby="hero-leaderboard-title">
      <table class="hero-ranking-table">
        <thead>
          <tr>
            <th scope="col">Rank</th>
            <th scope="col">Hero</th>
            <th scope="col">Farm</th>
            <th scope="col">Time</th>
          </tr>
        </thead>
        <tbody>
          <.ranking_entry
            :for={entry <- @leaderboard_entries}
            hero={entry.hero}
            position={entry.position}
            selected={entry.hero.id == @hero.id}
            scroll={entry.hero.id == @hero.id}
            preview={@preview}
          />
        </tbody>
        <tfoot :if={!Enum.any?(@leaderboard_entries, &(&1.hero.id == @hero.id))}>
          <.ranking_entry hero={@hero} position={@leaderboard_position} selected={true} scroll={false} preview={@preview} />
        </tfoot>
      </table>
      <div :if={@ranking_tab == "league" && @league_ranking.total == 0} id="hero-league-empty" class="hero-league-empty">
        <.icon name="game-trophy" />
        <strong>A new league story starts here</strong>
        <p>Be the first to finish a run in these standings.</p>
      </div>
    </div>
    <aside id="hero-league-milestone" class="hero-league-milestone" aria-labelledby="hero-league-milestone-title">
      <img src={"/images/league/#{@league_milestone.tier}.png"} alt="" />
      <div><span>Next milestone</span><h3 id="hero-league-milestone-title">{@league_milestone.title}</h3><p>{@league_milestone.description}</p></div>
    </aside>
  </section>
</div>
