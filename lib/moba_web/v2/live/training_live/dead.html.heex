<%= if @preview do %>
  <% gold_cost = Game.buyback_price(@current_hero)
  enough_gold? = @current_hero.gold >= gold_cost %>
  <section id="death-panel" class="death-panel" aria-labelledby="death-title">
    <div class="death-overview">
      <span class="death-emblem" aria-hidden="true"><i class="fa fa-skull-crossbones"></i></span>
      <p class="death-eyebrow">Training interrupted</p>
      <h2 id="death-title">Your hero has fallen.</h2>
      <p class="death-description">Buy back your hero to continue battling, or begin again with a fresh start.</p>
    </div>
    <div class="death-buybacks" aria-label="Buyback options">
      <div class="death-option">
        <div class="death-currency death-gold">
          <i class="fa fa-coins" aria-hidden="true"></i>
          <div>
            <h3>Gold buyback</h3>
            <p>{@current_hero.gold} Gold available</p>
          </div>
        </div>
        <strong class="death-price death-gold" id="death-gold-cost">{gold_cost}<small>Gold</small></strong>
        <button
          type="button"
          class="btn death-revive"
          id="buyback-hero"
          phx-click="buyback"
          disabled={!enough_gold?}
          phx-disable-with="Reviving…"
          aria-describedby={if !enough_gold?, do: "death-gold-help"}
        >
          Buy back <span aria-hidden="true">→</span>
        </button>
        <p :if={!enough_gold?} id="death-gold-help" class="death-buyback-help">
          You need {gold_cost - @current_hero.gold} more Gold. Sell an item in the Shop to buy back.
        </p>
      </div>
      <%= if shard_count = Moba.can_shard_buyback?(@current_hero) do %>
        <div class="death-option">
          <div class="death-currency death-shards">
            <i class="fab fa-ethereum" aria-hidden="true"></i>
            <div>
              <h3>Shard buyback</h3>
              <p>{shard_count} Shards available</p>
            </div>
          </div>
          <strong class="death-price death-shards" id="death-shard-cost">
            {Moba.shard_buyback_price(shard_count)}<small>Shards</small>
          </strong>
          <button
            type="button"
            class="btn base-secondary"
            id="shard-buyback-hero"
            phx-click="shard-buyback"
            phx-disable-with="Reviving…"
          >
            Use Shards <span aria-hidden="true">→</span>
          </button>
        </div>
      <% end %>
    </div>
    <div class="death-alternatives">
      <div>
        <h3>Begin again</h3>
        <p>Choose your next journey.</p>
      </div>
      <div class="death-alternative">
        <button
          type="button"
          phx-click="restart"
          id="restart-hero"
          class="btn base-secondary"
          data-confirm="Restart this hero at level 1 with the same build?"
          data-confirm-title="Restart training?"
          data-confirm-accept="Restart hero"
        >
          <i class="fa fa-recycle" aria-hidden="true"></i>Restart Hero
        </button>
        <small>Level 1 · Same build</small>
      </div>
      <div class="death-alternative">
        <.link id="death-new-hero" navigate={preview_path(assigns, ~p"/invoke")} class="btn base-secondary">
          <i class="fa fa-user-plus" aria-hidden="true"></i>New Hero
        </.link>
        <small>Your current hero is saved</small>
      </div>
    </div>
  </section>
<% else %>
  <div class="card-box border border-light bg-light" style="height: 450px">
    <p class="text-center mt-1"><i class="fa fa-skull-crossbones fa-3x text-dark"></i></p>
    <h2 class="text-center mb-0">
      You are DEAD
    </h2>
    <h3 class="text-muted text-center mb-4">You can continue battling by buying back your hero</h3>
    <div class="text-center mt-2 mb-2">
      <%= if @current_hero.gold >= Game.buyback_price(@current_hero) do %>
        <button
          class="btn btn-warning btn-lg"
          phx-hook="Loading"
          loading="Respawning..."
          phx-click="buyback"
          id="buyback-hero"
        >
          <span class="loading-text">
            <i class="fa fa-coins mr-1"></i> Buyback with {Game.buyback_price(@current_hero)}g
          </span>
        </button>
      <% else %>
        <button class="btn btn-warning btn-lg disabled no-action">
          <span class="loading-text">
            <i class="fa fa-coins mr-1"></i>
            You do not have {Game.buyback_price(@current_hero)}g to Buyback, try selling one of your items on the Shop
          </span>
        </button>
      <% end %>
    </div>
    <%= if shard_count = Moba.can_shard_buyback?(@current_hero) do %>
      <div class="text-center">
        <h3>or</h3>
      </div>
      <div class="text-center mt-2 mb-4">
        <button
          class="btn btn-primary btn-lg"
          phx-hook="Loading"
          loading="Respawning..."
          phx-click="shard-buyback"
          id="shard-buyback-hero"
        >
          <span class="loading-text">
            <i class="fab fa-ethereum mr-1"></i>
            Buyback with {Moba.shard_buyback_price(shard_count)} Shards ({shard_count} left)
          </span>
        </button>
      </div>
    <% end %>
    <div class="text-center mt-4">
      <button
        phx-click="restart"
        id="restart-hero"
        class="btn btn-sm btn-danger"
        data-toggle="tooltip"
        title="Resets your hero back to level 1 with the same build."
        data-confirm="WARNING: This reset your hero to level 1."
      >
        <i class="fa fa-recycle mr-1"></i>Restart Hero
      </button>
      <.link
        navigate={preview_path(assigns, ~p"/invoke")}
        class="btn btn-success btn-sm ml-5"
        data-toggle="tooltip"
        title="Create a new hero. Your current hero will be saved."
      >
        <i class="fa fa-user-plus mr-1"></i>New Hero
      </.link>
    </div>
  </div>
<% end %>
