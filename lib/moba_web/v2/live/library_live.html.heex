<Layouts.app
  preview={@preview}
  flash={@flash}
  current_scope={@current_scope}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code={@sidebar_code}
  hide_footer
>
  <main class="content catalog-viewport catalog-compact" id="library" phx-hook="ManualCodex" phx-update="ignore">
    <header
      :if={@preview}
      class="catalog-heading"
      id="manual-heading"
      style="--manual-scene: url(/images/training/meditation-dark-fantasy.png)"
    >
      <div class="manual-heading-copy">
        <p class="catalog-eyebrow">Knowledge is power</p>
        <div class="manual-title-row">
          <h1 id="manual-title">Library</h1>
          <p class="manual-heading-description">Refine your strategy.</p>
        </div>
      </div>
      <.catalog_discord_link id="manual-discord" />
    </header>
    <div class="cinematic-catalog-tabs" role="tablist" aria-label="Library reference">
      <button
        :for={
          {key, label, icon, tone} <- [
            {"avatars", "Avatars", "nav-profile", nil},
            {"skills", "Skills", "nav-manual", "blue"},
            {"items", "Items", "nav-catalog-items", "violet"}
          ]
        }
        type="button"
        id={"library-tab-#{key}"}
        data-catalog-tone={tone}
        data-library-tab
        role="tab"
        aria-selected={to_string(key == "avatars")}
        aria-controls={"manual-#{key}"}
        tabindex={if key == "avatars", do: 0, else: -1}
      >
        <.icon name={icon} />
        <span>{label}</span>
      </button>
    </div>

    <section id="manual-avatars" class="manual-reference-section" role="tabpanel" aria-labelledby="library-tab-avatars">
      <div class="manual-reference-frame"><.avatar_reference avatars={@avatars} /></div>
    </section>
    <section
      id="manual-skills"
      class="manual-reference-section"
      role="tabpanel"
      aria-labelledby="library-tab-skills"
      hidden
    >
      <div class="manual-reference-frame"><.skill_reference skills={@skills} /></div>
    </section>
    <section
      id="manual-items"
      class="manual-reference-section cinematic-shop library-shop"
      role="tabpanel"
      aria-labelledby="library-tab-items"
      hidden
    >
      <.item_reference items={@items} />
    </section>
  </main>
</Layouts.app>
