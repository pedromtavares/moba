<Layouts.app
  preview={@preview}
  flash={@flash}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code={@sidebar_code}
>
  <div class="content" id="library">
  <header :if={@preview} class="manual-heading" id="manual-heading" style="--manual-scene: url(/images/training/meditation-dark-fantasy.png)">
    <div class="manual-heading-copy">
      <p class="manual-eyebrow">Knowledge is power</p>
      <h1 id="manual-title">Game Manual</h1>
      <p class="manual-heading-description">Master the rules. Refine your strategy.</p>
      <nav aria-label="Manual reference">
        <a href="#manual-avatars">Explore avatars <span aria-hidden="true">↓</span></a>
        <a href="#manual-skills">Browse skills <span aria-hidden="true">↓</span></a>
      </nav>
    </div>
    <a id="manual-discord" href="https://discord.gg/QNwEdPS" target="_blank" rel="noopener noreferrer" class="manual-discord"><i class="ui-icon ui-chat-controller" aria-hidden="true"></i><span>Join our Discord</span><span aria-hidden="true">↗</span></a>
  </header>
  <div :if={!@preview} class="row mt-2">
    <div class="col">
      <a
        href="https://discord.gg/QNwEdPS"
        target="_blank"
        class="btn p-2 btn-block btn-lg btn-purple col-xl-4 margin-auto"
      >
        <i class="ui-icon ui-chat-controller mr-1"></i>Join our Discord!
      </a>
    </div>
  </div>

  <div class="row mt-2">
    <div class="col-12">
      <div class="card-box">
        <ul class="nav nav-pills navtab-bg manual-navigation" id="manual-navigation" aria-label="Manual sections">
          <li class="nav-item">
            <a href="#faq-tab" data-toggle="tab" class="nav-link px-3 py-2 active">
              <span class="d-inline-block d-sm-none"><i class="ui-icon ui-question mr-1"></i>FAQ</span>
              <span class="d-none d-sm-inline-block">
                <i class="ui-icon ui-question mr-1"></i>Frequently Asked Questions
              </span>
            </a>
          </li>
          <li class="nav-item">
            <a href="#training-tab" data-toggle="tab" class="nav-link px-3 py-2">
              <span class="d-inline-block d-sm-none"><i class="ui-icon ui-sword mr-1"></i>Training</span>
              <span class="d-none d-sm-inline-block"><i class="ui-icon ui-sword mr-1"></i>Training Guide</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="#arena-tab" data-toggle="tab" class="nav-link px-3 py-2">
              <span class="d-inline-block d-sm-none"><i class="ui-icon ui-swords mr-1"></i>Arena</span>
              <span class="d-none d-sm-inline-block"><i class="ui-icon ui-swords mr-1"></i>Arena Guide</span>
            </a>
          </li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane fade active show" id="faq-tab">
            <div class="row pt-2">
              <div class="col-lg-6">
                <div class="p-lg-2">
                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">What is the main game objective, Training or Arena?</h4>
                    <p class="faq-answer mb-4">
                      The main game objective, which is the hardest challenge in this game, is to reach the Invoker rank in Training. You will need to not only reach Grandmaster League with 20 different Avatars but also do a "perfect run" of 60K Total Farm with each of them in order to reach Invoker.<br />However, there is also a PvP Season Ranking which players compete for that you can only score by playing in the Arena and maintaining rank #1 there for multiple days.
                    </p>
                  </div>

                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">
                      What is the utility of Shards <i class="ui-icon ui-shard"></i> ?
                    </h4>
                    <p class="faq-answer mb-4">
                      Shards are the in-game currency that is used to unlock content like avatars, skills and skins in the Tavern. The best way to acquire Shards is to compete in the PvP Arena.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="p-lg-2">
                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">How do stats like Speed, Power and Armor work?</h4>
                    <p class="faq-answer mb-4">
                      While Training, you can mouse over your hero's stats in the bottom bar to see details about them, but, in short, Speed is what decides if you attack first (80 Speed = 80% chance of attacking first), Power is a multiplier that raises your damage and regeneration (30 Power = 30% extra damage/regen) and Armor is a multiplier that reduces the damage you take (20 Armor = 20% reduction).
                    </p>
                  </div>

                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">How are Heroes ranked?</h4>
                    <p class="faq-answer mb-4">
                      Heroes are ranked first by their Total Farm, which is a sum of their total XP farm and total Gold farm, and second by the time it took to finish Training. Since there is a Total Farm limit of 60K (30K XP and 30K gold), experienced players compete on who can reach that limit the fastest by leveling skills and buying items in the most optimal order, along with choosing the best targets for their build.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="tab-pane fade" id="training-tab">
            <div class="row pt-2">
              <div class="col-lg-6">
                <div class="p-lg-2">
                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">What is the main objective of Training?</h4>
                    <p class="faq-answer mb-4">
                      To reach the Invoker rank: Initiate -> Novice -> Adept -> Veteran -> Expert -> Master -> Grandmaster -> Invoker. The most optimal way to get there is to spend all of your turns Battling. Passive farming by Meditating or Mining will be much faster and can still yield decent results in lower ranks, but it is recommended to Battle on all turns after you've reached Expert.
                    </p>
                  </div>
                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">Should I battle or meditate/mine?</h4>
                    <p class="faq-answer mb-4">
                      Battling will always offer more rewards but it comes with more risk as you can die and have to buyback. Meditating/mining is a safe choice but can randomly offer very low rewards. Ideally you should only meditate/mine if you have no good targets to battle or if you have a specific build in mind that needs more XP or gold early on.
                    </p>
                  </div>
                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">How do I get to Grandmaster League?</h4>
                    <p class="faq-answer mb-4">
                      You must be at least a Veteran to unlock the Grandmaster League. Level up your hero without losing a single League Challenge and you will be presented with a chance to fight Roshan, the final boss of the Master League. You have 2 chances of beating Roshan and will finish in the Master League if you fail these chances.
                    </p>
                  </div>
                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">What is a good strategy for Training?</h4>
                    <p class="faq-answer mb-4">
                      Avoid dying as much as possible and always buy Normal/Rare items when you have the gold to do so, remember, you can always Transmute them into better items later. If there aren't any targets you are confident in killing, aim for targets with low Offense to reduce your chances of dying. Aim for Normal and Hard targets only for optimal farming.
                    </p>
                  </div>
                </div>
              </div>

              <div class="col-lg-6">
                <div class="p-lg-2">
                  <div class="mt-5">
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">Should I make more than one hero?</h4>
                    <p class="faq-answer mb-4">
                      Yes! Each Avatar has a different playstyle so it's worth experimenting to see which ones you like most. Training with multiple Avatars will not only give you insights about their strengths and weaknesses (crucial for the Arena) but also unlock higher ranks in the Base progression which will make the game more challenging, interesting and fun!
                    </p>
                  </div>

                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">How can I compete for the top 10 in the Hero Ranking?</h4>
                    <p class="faq-answer mb-4">
                      Top ranked Heroes have usually finished a "Perfect Run" by beating all Hard targets without buying back with gold, thus guaranteeing the maximum Total Farm of 60K. While possible in lower ranks, it becomes more viable once you have an Expert rank (Initiate->Novice->Adept->Veteran->Expert) on the Base progression in order to maximize the amount of farm you can get by always having 9 Hard targets available.<br /><br />When aiming for a Perfect Run, it's also important to have at least 100 Shards in order to use the 'Buyback with Shards' button if you happen to die, this won't affect your Total Farm but will use up 5% of your available Shards. Note that buying back with Shards is not available once on the Master League, and dying is overall less optimal as you waste time with a useless battle, so make sure to always use your Target Refreshes if you're unsure if you can kill a target.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="tab-pane fade" id="arena-tab">
            <div class="row pt-2">
              <div class="col-lg-6">
                <div class="p-lg-2">
                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">How is the Arena different from Training?</h4>
                    <p class="faq-answer mb-4">
                      In the Arena you get to play with the heroes you finished Training with. After Training is finished, you can change your items without any gold penalty for selling in order to adjust your build as much as you like for the Arena.
                      <br /><br />
                      Unlike Training in which you battle against another hero 1v1, Arena matches are 5v5 battles where you pick a team of 5 heroes to battle against the opponent's team until the last hero standing. Make sure you have at least 5 good heroes trained in order to perform well in the Arena.
                      <br /><br />
                      Similar to how in Training you have 30 total turns to train your Hero, in the Arena you have 30 daily matches that you need to win in order to eventually reach rank #1.
                    </p>
                  </div>

                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">What is the main objective of the Arena?</h4>
                    <p class="faq-answer mb-4">
                      There are 3 player brackets in the Arena: Plebs -> Shadows -> Immortals. The objective is to become The Immortal, which is the best performing player in the Immortals bracket that is also ranked #1 on the Daily Ranking. Every day the Arena will reset and the best performing players of each bracket will move on to the next bracket while the worst performing players will move down.<br />Players who can consistently keep #1 rank on the Daily Ranking will also have a higher rank on the Season Ranking.
                    </p>
                  </div>

                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">What is the Season Ranking?</h4>
                    <p class="faq-answer mb-4">
                      On the Ranking section of the Profile page you can click on the
                      <i class="ui-icon ui-shuffle mr-1 text-primary"></i>
                      icon to switch the Daily Ranking to the Season Ranking, which displays the best players of the Season, who are defined by the highest Season Score, which is calculated based on your Training Rank and Arena performance.
                      <br /><br />
                      In the Arena, when you become The Immortal your Immortal Streak increases by 1 and you must keep the title in order to further increase your Streak. Each streak will give you 100 Season Score and will likely define your spot in the Season Ranking.
                      <br />An important note: If you have an active Immortal Streak, your heroes will receive a debuff that lowers their stats in Matchmaking battles by <%= Float.round(Moba.immortal_streak_multiplier() * 100, 1) %>% per streak. The higher the streak, the higher the nerf and the harder it is to keep the streak.
                    </p>
                  </div>
                </div>
              </div>

              <div class="col-lg-6">
                <div class="p-lg-2">
                  <div class="mt-5">
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">How are Season Points calculated?</h4>
                    <p class="faq-answer mb-4">
                      You gain and lose Season Points with every Match and Duel in the Arena. The amount won/lost per battle depends on the difference of points between you and your opponent, similar to how the ELO system works. Duels that end in ties transfers points from the stronger (higher points) to the weaker (lower points).
                    </p>
                  </div>
                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">
                      Can I battle against other players in real time?
                    </h4>
                    <p class="faq-answer mb-4">
                      Yes. When there are other players online you can challenge them to a Duel in the right (third) column of the Arena. If they accept, you will both be redirected to the Duel page. Duels are a set of two 1v1 battles with alternating Hero picks, meaning you get to pick first in one battle and your opponent picks first on the second battle. This way, no player has an advantage and must rely on better strategies to beat their opponent.
                    </p>
                  </div>

                  <div>
                    <div class="faq-question-q-box">Q.</div>
                    <h4 class="faq-question text-primary">What is a good strategy for the Arena?</h4>
                    <p class="faq-answer mb-4">
                      Having a varied Hero collection with at least 5 trained Grandmaster heroes is the best way to outperform your opponents in the Arena because you will be able to "outpick" and better react to what your opponent throws against you. Remember, you always have the advantage in Matchmaking since you are always the attacker and can see your opponent's picks beforehand, so make use of that advantage and counter-pick accordingly!
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col">
      <h3 class="page-title mb-3 text-center" id="manual-avatars">
        <i class="ui-icon ui-users mr-2"></i>Avatars
      </h3>
    </div>
  </div>
  <div class="row">
    <%= for avatar <- @avatars do %>
      <div class="col-12 col-md-6 col-lg-4 col-xl-3 text-center mb-3 select-avatar">
        <div class="card-box mb-0">
          <img
            src={GH.image_url(avatar)}
            class="avatar img-border"
            style="width: 150px;max-width: unset;"
            data-toggle="tooltip"
            title={"<img src='#{GH.background_url(avatar)}' style='max-width:500px'/>"}
          />

          <br />
          <div>
            <h4 class="mt-1">{avatar.name}</h4>
            <span class="game-stat btn btn-outline-dark btn-sm no-action">
              <i class="ui-icon ui-d20 mr-1"></i>{GH.role_name(avatar.role)}
            </span>
          </div>
          <div class="btn-group mb-1 mt-1 manual-stat-row">
            <span class="game-stat btn btn-icon waves-effect waves-light btn-outline-dark text-pink btn-sm">
              <small :if={@preview}>Power</small>
              <i class="ui-icon ui-vortex mr-1"></i>{avatar.power}
            </span>
            <span class="game-stat btn btn-icon waves-effect waves-light btn-outline-dark text-warning btn-sm">
              <small :if={@preview}>Armor</small>
              <i class="ui-icon ui-shield mr-1"></i>{avatar.armor}
            </span>
            <span class="game-stat btn btn-icon waves-effect waves-light btn-outline-dark text-orange btn-sm">
              <small :if={@preview}>Speed</small>
              <i class="ui-icon ui-runner mr-1"></i>{avatar.speed}
            </span>
          </div>
          <div class="btn-group manual-stat-row">
            <span class="game-stat btn btn-icon waves-effect btn-outline-dark text-danger btn-sm">
              <small :if={@preview}>Health / level</small>
              <i class="ui-icon ui-heart mr-1"></i>{avatar.total_hp} ({avatar.hp_per_level})
            </span>
            <span class="game-stat btn btn-icon waves-effect waves-light btn-outline-dark text-info btn-sm">
              <small :if={@preview}>Energy / level</small>
              <i class="ui-icon ui-bolt mr-1"></i>{avatar.total_mp} ({avatar.mp_per_level})
            </span>
            <span class="game-stat btn btn-icon waves-effect waves-light btn-outline-dark text-success btn-sm">
              <small :if={@preview}>Attack / level</small>
              <i class="ui-icon ui-dagger mr-1"></i>{avatar.atk} ({avatar.atk_per_level})
            </span>
          </div>
          <div class="row mt-1">
            <%= for ultimate <- ultimates_for(avatar, @ultimates) do %>
              <div class="col-4">
                <.skill_image skill={ultimate} class="img-border-sm" style="width: 60px" />
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="row">
    <div class="col">
      <h3 class="page-title mb-3 text-center" id="manual-skills">
        <i class="ui-icon ui-wand mr-2"></i>Skills
      </h3>
    </div>
  </div>

  <div class="row">
    <%= for {first, levels} <- @skills do %>
      <div class="col-12 col-md-6 col-lg-4 col-xl-3 text-center mb-3 select-avatar">
        <div class="card-box mb-0">
          <.skill_image skill={first} class="skill-img img-border-sm" style="width: 80px" />
          <br />
          <div>
            <h4 class="mt-1">{first.name}</h4>
          </div>
          <div class="btn-group">
            <%= for level <- levels do %>
              <span
                tabindex="0"
                class="game-stat btn btn-outline-dark btn-sm"
                data-toggle="tooltip"
                title={TT.skill_tooltip(level, true, false)}
              >
                {if @preview, do: "Lv #{level.level}", else: level.level}
              </span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  </div>
</Layouts.app>
