<% picking? = is_nil(@match.phase) && !@starting
owner? = @current_player.id == @match.player_id
complete? = @match.phase in ["finished", "scored"] && @tick >= length(@battles)
revealed = Enum.take(@battles, @tick)
last_reveal = if @tick > 0 && @tick <= length(@battles), do: List.last(revealed) %>
<div id="match-hud" class="matches squad-page match-modern" data-playback={to_string(!picking?)}>
  <div class="squad-columns match-columns">
    <section class="squad-panel match-lineup" aria-labelledby="match-your-lineup">
      <div class="squad-panel-heading">
        <.link
          navigate={preview_path(assigns, ~p"/player/#{@match.player}")}
          data-profile-username={Moba.Utils.username(@match.player)}
          class="match-player"
          id="player-card"
        >
          <img src={"/images/pve/#{@match.player.pve_tier}.png"} alt="" />
          <span>
            {username(@match.player)}<small id="match-your-lineup">{if owner?, do: "Your lineup", else: "Challenger lineup"}</small>
          </span>
        </.link>
        <div class="match-lineup-actions">
          <.link
            :if={owner?}
            id="edit-teams-button"
            navigate={preview_path(assigns, ~p"/arena/edit?#{[match_id: @match.id]}")}
            class="btn base-secondary match-edit-teams"
          >
            <.icon name="game-team" /> Edit Teams
          </.link>
          <strong>{length(@picked_heroes)} / {@match.team_size}</strong>
        </div>
        <.immortal_streak_debuff
          id="match-player-streak-debuff"
          player={@match.player}
          streak={GH.match_immortal_streak(@match.player, @battles)}
          class="match-streak-debuff"
        />
      </div>
      <div class="squad-scroll lineup-list">
        <%= for position <- 1..@match.team_size do %>
          <%= if hero = Enum.at(@picked_heroes, position - 1) do %>
            <div id={"hero-#{hero.id}"}>
              <.roster_hero
                hero={hero}
                stats={GH.match_hero_stats(hero, @match.player, @battles)}
                position={position}
                defeated={eliminated?(hero, @match.player, revealed)}
                falling={!is_nil(last_reveal) && eliminated?(hero, @match.player, [last_reveal])}
              >
                <:actions :if={picking? && owner?}>
                  <button
                    type="button"
                    class="btn squad-order"
                    phx-click="move-up"
                    phx-value-id={hero.id}
                    id={"move-up-#{hero.id}"}
                    disabled={position == 1}
                    aria-label={"Move #{hero.name} up"}
                  >
                    ↑
                  </button>
                  <button
                    type="button"
                    class="btn squad-order"
                    phx-click="move-down"
                    phx-value-id={hero.id}
                    id={"move-down-#{hero.id}"}
                    disabled={position == length(@picked_heroes)}
                    aria-label={"Move #{hero.name} down"}
                  >
                    ↓
                  </button>
                  <button
                    type="button"
                    class="btn squad-remove"
                    phx-click="unpick-hero"
                    phx-value-id={hero.id}
                    id={"lineup-unpick-#{hero.id}"}
                    aria-label={"Remove #{hero.name} from lineup"}
                  >
                    <span aria-hidden="true">×</span>
                  </button>
                </:actions>
              </.roster_hero>
            </div>
          <% else %>
            <div class="squad-empty-slot" id={"match-empty-slot-#{position}"}>
              <span>{position}</span><strong>Open slot</strong>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
    <section class="squad-panel match-center" aria-label={if picking?, do: "Choose heroes", else: "Match battles"}>
      <header id="match-scoreboard" class="match-scoreboard" data-complete={to_string(complete?)}>
        <div class="match-score" aria-label="Heroes defeated">
          <span class="squad-eyebrow">Arena · {@match.team_size}v{@match.team_size}</span>
          <strong>
            {Enum.count(revealed, &(&1.winner_player_id == @match.player_id))}<span>—</span>{Enum.count(
              revealed,
              &(&1.winner_player_id == @match.opponent_id)
            )}
          </strong>
          <span>{if picking?, do: "Picking heroes", else: "Heroes defeated"}</span>
        </div>
      </header>
      <div id="winner-card" class="match-command" data-complete={to_string(complete?)}>
        <%= cond do %>
          <% picking? && owner? -> %>
            <div id="match-pick-status">
              <div class="match-pick-heading">
                <h2 id="match-pick-status-title">
                  {if length(@picked_heroes) >= @match.team_size, do: "Lineup ready", else: "Choose your lineup"}
                </h2>
                <strong class="hud-notice-counter">{length(@picked_heroes)}<small> / {@match.team_size}</small></strong>
              </div>
              <div
                class="match-pick-progress"
                aria-label={"#{length(@picked_heroes)} of #{@match.team_size} heroes selected"}
              >
                <span :for={slot <- 1..@match.team_size} data-filled={to_string(slot <= length(@picked_heroes))}></span>
              </div>
              <button
                :if={length(@picked_heroes) >= @match.team_size}
                type="button"
                class="btn battle-primary"
                data-game-fullscreen
                phx-click="start"
                phx-disable-with="Starting…"
                id="start-match-button"
              >
                Start match →
              </button>
              <button
                :if={length(@picked_heroes) < @match.team_size && @latest_match}
                type="button"
                class="btn base-secondary"
                phx-click="repeat"
                id="repeat-match-lineup"
              >
                Use last lineup
              </button>
            </div>
          <% picking? -> %>
            <.hud_notice
              id="match-pick-status"
              title="Choosing heroes"
              description={"#{username(@match.player)} is picking their lineup."}
            />
          <% true -> %>
            <div id="match-playback-status" class="match-playback-status">
              <span class="squad-eyebrow">
                {if complete?, do: "Match complete", else: "Battle #{min(length(revealed) + 1, 9)}"}
              </span>
              <h2>
                {if complete? && @match.winner,
                  do: "#{username(@match.winner)} wins",
                  else: if(complete?, do: "Match drawn", else: "Match in progress")}
              </h2>
              <span>{length(revealed)} {if length(revealed) == 1, do: "battle", else: "battles"} resolved</span>
              <button
                id="match-details-toggle"
                type="button"
                phx-click="toggle-battle-details"
                class="btn base-secondary"
                aria-pressed={to_string(@show_battle_details)}
              >
                {if @show_battle_details, do: "Summary", else: "Battle details"}
              </button>
            </div>
        <% end %>
      </div>
      <%= if picking? && owner? do %>
        <.hero_picker {assigns} />
      <% else %>
        <div
          id="match-battles"
          class={["squad-scroll match-battles", !@show_battle_details && "match-summary-list"]}
          style={"--match-battle-rows: #{max(length(@battles), 1)}"}
        >
          <.hud_notice
            :if={revealed == [] && !picking?}
            id="match-resolving"
            title="Heroes entering battle"
            description="The first result will appear here."
          />
          <%= for {battle, index} <- Enum.with_index(revealed, 1) do %>
            <%= if @show_battle_details do %>
              <.match_battle battle={battle} match={@match} index={index} preview={@preview} />
            <% else %>
              <.match_summary battle={battle} match={@match} index={index} preview={@preview} />
            <% end %>
          <% end %>
        </div>
        <.link
          :if={complete?}
          id="match-return-to-arena"
          navigate={preview_path(assigns, ~p"/arena")}
          class="btn base-secondary match-return-to-arena"
        >
          Return to arena <span aria-hidden="true">→</span>
        </.link>
      <% end %>
    </section>
    <section class="squad-panel match-lineup match-enemy" aria-labelledby="match-opponent-lineup">
      <div class="squad-panel-heading">
        <.link
          navigate={preview_path(assigns, ~p"/player/#{@match.opponent}")}
          data-profile-username={Moba.Utils.username(@match.opponent)}
          class="match-player match-player-opponent"
          id="opponent-card"
        >
          <img src={"/images/pve/#{@match.opponent.pve_tier}.png"} alt="" />
          <span>{username(@match.opponent)}<small id="match-opponent-lineup">Opponent lineup</small></span>
        </.link>
        <strong>{length(@match.opponent_picks)} / {@match.team_size}</strong>
        <.immortal_streak_debuff
          id="match-opponent-streak-debuff"
          player={@match.opponent}
          streak={GH.match_immortal_streak(@match.opponent, @battles)}
          class="match-streak-debuff"
        />
      </div>
      <div class="squad-scroll lineup-list" id="opponent-heroes-container">
        <div :for={{hero, index} <- Enum.with_index(@match.opponent_picks, 1)} id={"opponent-hero-#{hero.id}"}>
          <.roster_hero
            hero={hero}
            stats={GH.match_hero_stats(hero, @match.opponent, @battles)}
            position={index}
            defeated={eliminated?(hero, @match.opponent, revealed)}
            falling={!is_nil(last_reveal) && eliminated?(hero, @match.opponent, [last_reveal])}
          />
        </div>
      </div>
    </section>
  </div>
</div>
