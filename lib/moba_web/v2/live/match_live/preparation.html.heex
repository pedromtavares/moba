<% reviewing? = !is_nil(@match.phase)
owner? = @current_player.id == @match.player_id
can_edit_lineup? = owner? && !reviewing? && !@starting
battles = if reviewing?, do: finished_battles(@battles), else: []
complete? = @match.phase in ["finished", "scored"] %>
<main
  id="match-hud"
  class={["arena-preparation", reviewing? && "arena-match-review"]}
  data-playback={to_string(reviewing?)}
  phx-hook={if !reviewing?, do: "LineupOrder"}
  data-lineup-id={can_edit_lineup? && @match.id}
  data-lineup-add-event="pick-hero"
>
  <header class="arena-preparation-heading">
    <div>
      <span class="squad-eyebrow">Arena · 3v3</span>
      <h1>
        <%= cond do %>
          <% !reviewing? -> %>
            Choose your lineup
          <% complete? && @match.winner -> %>
            {username(@match.winner)} wins
          <% complete? -> %>
            Match drawn
          <% true -> %>
            Match in progress
        <% end %>
      </h1>
    </div>
    <div :if={battles != []} id="arena-match-score" class="arena-match-score" aria-label="Battles won">
      <strong>{Enum.count(battles, &(&1.winner_player_id == @match.player_id))}</strong>
      <span aria-hidden="true">—</span>
      <strong>{Enum.count(battles, &(&1.winner_player_id == @match.opponent_id))}</strong>
    </div>
    <div class="arena-preparation-actions">
      <%= if reviewing? do %>
        <.link
          :if={@battles != []}
          id="arena-match-details"
          navigate={~p"/matches/#{@match.id}/battles"}
          class="btn base-secondary"
        >
          <.icon name="game-battle-log" /> Battle details
        </.link>
        <.link id="match-return-to-arena" navigate={~p"/arena"} class="btn base-secondary">Return to arena →</.link>
      <% else %>
        <.link id="edit-teams-button" navigate={~p"/arena/edit?#{[match_id: @match.id]}"} class="btn base-secondary">
          <.icon name="game-team" /> Edit teams
        </.link>
        <button
          :if={owner?}
          id="start-match-button"
          type="button"
          class="btn battle-primary"
          phx-click="start"
          data-game-fullscreen
          disabled={length(@picked_heroes) != 3 || @starting}
        >
          <.icon name="game-arena-3v3" /> {if @starting, do: "Preparing…", else: "Begin battle"} →
        </button>
      <% end %>
    </div>
  </header>
  <div class="arena-preparation-rosters">
    <section class="arena-preparation-side match-lineup">
      <header>
        <div class="arena-lineup-heading">
          <h2>{if reviewing?, do: username(@match.player), else: "Your lineup"}</h2>
          <button
            :if={can_edit_lineup? && @latest_match}
            id="repeat-picks-button"
            type="button"
            phx-click="repeat"
            class="arena-repeat-lineup"
          >
            <.icon name="game-refresh" /> Repeat last
          </button>
        </div>
        <span>{length(@picked_heroes)} / 3</span>
        <.immortal_streak_debuff
          id="match-player-streak-debuff"
          player={@match.player}
          streak={GH.match_immortal_streak(@match.player, battles)}
          class="match-streak-debuff"
        />
      </header>
      <div id="arena-player-lineup" class="arena-preparation-cards lineup-list">
        <%= for position <- 1..3 do %>
          <%= if hero = Enum.at(@picked_heroes, position - 1) do %>
            <.lineup_card
              hero={hero}
              player={@match.player}
              battles={battles}
              position={position}
              opponent={false}
              picking={can_edit_lineup?}
              can_reorder={length(@picked_heroes) > 1}
            />
          <% else %>
            <div class="arena-draft-empty" id={"match-empty-slot-#{position}"} data-lineup-empty={!reviewing?}>
              <strong>0{position}</strong><span>{if reviewing?, do: "Open slot", else: "Choose a hero"}</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
    <section class="arena-preparation-side match-enemy">
      <header>
        <h2>{username(@match.opponent)}</h2>
        <span>Opponent lineup</span>
        <.immortal_streak_debuff
          id="match-opponent-streak-debuff"
          player={@match.opponent}
          streak={GH.match_immortal_streak(@match.opponent, battles)}
          class="match-streak-debuff"
        />
      </header>
      <div class="arena-preparation-cards">
        <.lineup_card
          :for={{hero, position} <- Enum.with_index(Enum.reject(@match.opponent_picks, &is_nil/1), 1)}
          hero={hero}
          player={@match.opponent}
          battles={battles}
          position={position}
          opponent={true}
          picking={false}
          can_reorder={false}
        />
      </div>
    </section>
  </div>
  <.arena_summary :if={reviewing?} match={@match} battles={battles} complete={complete?} />
  <section :if={!reviewing?} id="picks-card" class="arena-draft-library match-picker">
    <div class="arena-draft-teams">
      <header>
        <h2>Teams</h2>
        <div class="arena-library-controls">
          <button
            :if={length(@teams) > 6}
            id="arena-teams-prev"
            type="button"
            phx-click="source-page"
            phx-value-source="teams"
            phx-value-direction="previous"
            disabled={@teams_page == 0}
            aria-label="Previous teams"
          >
            ←
          </button>
          <button
            :if={length(@teams) > 6}
            id="arena-teams-next"
            type="button"
            phx-click="source-page"
            phx-value-source="teams"
            phx-value-direction="next"
            disabled={(@teams_page + 1) * 6 >= length(@teams)}
            aria-label="Next teams"
          >
            →
          </button>
        </div>
      </header>
      <div class="arena-draft-team-list">
        <%= for team <- Enum.slice(@teams, @teams_page * 6, 6) do %>
          <% selected? = @picked_heroes != [] && Enum.map(@picked_heroes, & &1.id) == team.pick_ids %>
          <div class="arena-team-tile">
            <button
              type="button"
              id={"pick-team-#{team.id}"}
              phx-click="pick-team"
              phx-value-id={team.id}
              class={["squad-team-choice", selected? && "active"]}
              aria-pressed={to_string(selected?)}
            >
              <span class="squad-team-name">{team.name}</span> <.lineup_preview heroes={team.picks} />
            </button>
            <button
              :if={selected?}
              id={"clear-team-#{team.id}"}
              class="arena-collection-remove"
              type="button"
              phx-click="clear-lineup"
              aria-label="Clear selected lineup"
            >
              ×
            </button>
          </div>
        <% end %>
        <p :if={@teams == []} class="arena-draft-hint">Save a team, or choose three heroes.</p>
      </div>
    </div>
    <div class="arena-draft-collection">
      <header>
        <h2>Hero collection</h2>
        <div class="arena-library-controls">
          <button
            :if={length(@trained_heroes) > 12}
            id="arena-heroes-prev"
            type="button"
            phx-click="source-page"
            phx-value-source="heroes"
            phx-value-direction="previous"
            disabled={@heroes_page == 0}
            aria-label="Previous heroes"
          >
            ←
          </button>
          <button
            :if={length(@trained_heroes) > 12}
            id="arena-heroes-next"
            type="button"
            phx-click="source-page"
            phx-value-source="heroes"
            phx-value-direction="next"
            disabled={(@heroes_page + 1) * 12 >= length(@trained_heroes)}
            aria-label="Next heroes"
          >
            →
          </button>
        </div>
      </header>
      <div class="arena-draft-hero-list">
        <%= for hero <- Enum.slice(@trained_heroes, @heroes_page * 12, 12) do %>
          <% picked? = Enum.any?(@picked_heroes, &(&1.id == hero.id)) %>
          <% can_pick? = can_edit_lineup? && !picked? && length(@picked_heroes) < 3 %>
          <div class={[
            "arena-collection-tile",
            picked? && "is-selected",
            !picked? && length(@picked_heroes) >= 3 && "is-unavailable"
          ]}>
            <button
              id={"pick-hero-#{hero.id}-trained"}
              type="button"
              phx-click="pick-hero"
              phx-value-id={hero.id}
              disabled={!can_pick?}
              data-lineup-add={can_pick? && hero.id}
              aria-label={"Add #{hero.avatar.name} to lineup"}
            >
              <img src={GH.image_url(hero.avatar)} alt={hero.avatar.name} /><span>{hero.avatar.name}</span><small>Lv {hero.level}</small>
            </button>
            <button
              :if={picked?}
              id={"collection-unpick-#{hero.id}"}
              class="arena-collection-remove"
              type="button"
              phx-click="unpick-hero"
              phx-value-id={hero.id}
              aria-label={"Remove #{hero.avatar.name} from lineup"}
            >
              ×
            </button>
          </div>
        <% end %>
        <.link :if={@trained_heroes == []} navigate={~p"/new"} class="btn base-secondary">Start training →</.link>
      </div>
    </div>
  </section>
</main>
