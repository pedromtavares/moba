<Layouts.app
  preview={@preview}
  flash={@flash}
  current_scope={@current_scope}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code={@sidebar_code}
>
  <main id="community" class="community catalog-viewport">
    <header
      id="community-heading"
      class="community-heading"
      style="--community-scene: url(/images/tutorial/hall-of-legends.jpg)"
    >
      <div class="community-heading-copy">
        <p class="community-eyebrow">The gathering hall</p>
        <h1>Community</h1>
      </div>
      <a
        href="https://discord.gg/QNwEdPS"
        target="_blank"
        rel="noopener noreferrer"
        class="btn base-secondary community-discord"
      >
        <i class="ui-icon ui-chat-controller" aria-hidden="true"></i>Join our Discord <span aria-hidden="true">↗</span>
      </a>
    </header>

    <nav class="cinematic-catalog-tabs" role="tablist" aria-label="Community">
      <button
        :for={
          {tab, label, icon} <-
            [
              {"online", "Recent players", "nav-community"},
              {"pvp", "Top players", "nav-profile"},
              {"teams", "Top teams", "nav-base"},
              {"pve", "Top heroes", "nav-training"}
            ] ++ if(@is_admin, do: [{"balance", "Arena stats", "nav-arena"}], else: [])
        }
        id={"show-#{tab}-link"}
        type="button"
        role="tab"
        class={@active_tab == tab && "active"}
        aria-label={label}
        aria-selected={to_string(@active_tab == tab)}
        aria-controls={"community-#{tab}"}
        phx-click={if @active_tab != tab, do: "show-#{tab}"}
      >
        <.icon name={icon} />
        <span>{label}</span>
      </button>
    </nav>

    <section :if={@active_tab == "online"} id="community-online" role="tabpanel" aria-labelledby="show-online-link">
      <div :if={@is_admin} id="community-admin-summary" aria-label="Activity metrics">
        <dl id="community-admin-metrics" class="community-admin-metrics">
          <div id="community-stat-guests">
            <dt><.icon name="game-hero" /><span>New guests</span></dt>
            <dd>{@user_stats.new_guests}</dd>
          </div>
          <div id="community-stat-accounts">
            <dt><.icon name="game-trophy" /><span>New accounts</span></dt>
            <dd>{@user_stats.new_users}</dd>
          </div>
          <div id="community-stat-active">
            <dt><.icon name="game-team" /><span>Active players</span></dt>
            <dd>{@user_stats.online_today}</dd>
          </div>
        </dl>
        <div class="community-admin-switch" role="group" aria-label="Activity period">
          <button
            :for={{period, label} <- [{"daily", "Daily"}, {"weekly", "Weekly"}]}
            id={"community-period-#{period}"}
            type="button"
            phx-click="user-filter"
            phx-value-period={period}
            aria-pressed={to_string(Atom.to_string(@user_filter) == period)}
          >
            {label}
          </button>
        </div>
      </div>
      <.recent_players
        id="community-recent-players"
        label="Recent players"
        empty="The hall is quiet. Recent players will appear here as they return."
        players={@players}
        guests={@guests}
        preview={@preview}
        current_player={@current_player}
        live_player_ids={@live_player_ids}
        admin={@is_admin}
      />
    </section>

    <section :if={@active_tab == "pvp"} id="community-pvp" role="tabpanel" aria-labelledby="show-pvp-link">
      <.community_pager id="community-pvp-pages" label="Top players">
        <div class="community-player-grid" data-community-page-group>
          <.player_card
            :for={player <- @pvp_ranking}
            preview={@preview}
            player={player}
            recent_results={Map.get(@pvp_recent_results, player.id, %{wins: 0, matches: 0})}
          />
          <p :if={@pvp_ranking == []} class="community-players-empty">No ranked players yet.</p>
        </div>
      </.community_pager>
    </section>

    <section :if={@active_tab == "teams"} id="community-teams" role="tabpanel" aria-labelledby="show-teams-link">
      <.community_pager id="community-teams-pages" label="Top teams">
        <div class="community-player-grid" data-community-page-group>
          <.team_card :for={entry <- @team_ranking} preview={@preview} entry={entry} />
          <p :if={@team_ranking == []} class="community-players-empty">No ranked teams yet.</p>
        </div>
      </.community_pager>
    </section>

    <section :if={@active_tab == "pve"} id="community-pve" role="tabpanel" aria-labelledby="show-pve-link">
      <.community_pager id="community-pve-pages" label="Top heroes">
        <div class="community-player-grid" data-community-page-group>
          <.pve_hero_card :for={hero <- @pve_ranking} preview={@preview} hero={hero} />
          <p :if={@pve_ranking == []} class="community-players-empty">No ranked heroes yet.</p>
        </div>
      </.community_pager>
    </section>

    <section
      :if={@is_admin && @active_tab == "balance"}
      id="community-balance"
      role="tabpanel"
      aria-labelledby="show-balance-link"
    >
      <div id="community-arena-stats" class="community-admin-panel">
        <header class="community-arena-stats-heading">
          <h2 id="community-arena-stats-title">Arena Stats</h2>
          <p id="community-balance-baseline">
            Avg Winrate: <strong>{Float.round(@match_stats.winrate * 1.0, 1)}%</strong>
            <small>({@match_stats.total} total matches)</small>
          </p>
          <div class="community-admin-switch" role="group" aria-label="Balance bracket">
            <button
              :for={
                {filter, label, id} <- [
                  {"pvp", "All", "immortal-ranking-button"},
                  {"plebs", "Plebs", "pleb-ranking-button"},
                  {"elite", "Elite", "elite-ranking-button"}
                ]
              }
              id={id}
              type="button"
              phx-click="match-filter"
              phx-value-type={filter}
              aria-pressed={to_string(@match_filter == filter)}
            >
              {label}
            </button>
          </div>
        </header>

        <div class="community-admin-switch community-balance-categories" role="group" aria-label="Arena stats category">
          <button
            :for={{key, label} <- [{:avatars, "Heroes"}, {:skills, "Skills"}, {:items, "Items"}]}
            id={"community-balance-category-#{key}"}
            type="button"
            phx-click="balance-category"
            phx-value-category={key}
            aria-pressed={to_string(@balance_category == key)}
          >
            {label}
          </button>
        </div>
        <.community_pager id={"community-balance-pages-#{@balance_category}-#{@match_filter}"} label="Win rates">
          <div class="community-arena-stats-tables">
            <.arena_stats
              :for={
                {side, title, records} <- [
                  {"highest", "Highest win rates", top_performing(@match_stats, @balance_category)},
                  {"lowest", "Lowest win rates", bottom_performing(@match_stats, @balance_category)}
                ]
              }
              records={records}
              key={@balance_category}
              side={side}
              title={title}
              match_filter={@match_filter}
            />
          </div>
        </.community_pager>
      </div>
    </section>
  </main>
</Layouts.app>
