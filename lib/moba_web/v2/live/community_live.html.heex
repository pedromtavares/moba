<Layouts.app
  preview={@preview}
  flash={@flash}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code={@sidebar_code}
>
  <div class="community">
  <header :if={@preview} id="community-heading" class="community-heading" style="--community-scene: url(/images/tutorial/hall-of-legends.jpg)">
    <div class="community-heading-copy">
      <p class="community-eyebrow">The gathering hall</p>
      <h1>Community</h1>
      <p class="community-heading-description">Share your victories. Shape what comes next.</p>
    </div>
    <a href="https://discord.gg/QNwEdPS" target="_blank" rel="noopener noreferrer" class="btn base-secondary community-discord"><i class="ui-icon ui-chat-controller" aria-hidden="true"></i>Join our Discord <span aria-hidden="true">↗</span></a>
  </header>
  <div :if={!@preview} class="row mt-2">
    <div class="col">
      <a
        href="https://discord.gg/QNwEdPS"
        target="_blank"
        class="btn p-2 btn-block btn-lg btn-purple col-xl-4 margin-auto"
      >
        <i class="ui-icon ui-chat-controller mr-1"></i>Join our Discord!
      </a>
    </div>
  </div>
  <div class="row mt-2 community-hub">
    <div class="col-lg-6">
      <div class="card mb-0 community-panel community-board" id="community-board">
        <h5 class="card-header font-17 text-white community-panel-heading">
          <i class="ui-icon ui-chat mr-1"></i>
          <span class="community-panel-title">Message Board</span><span class="text-muted font-italic font-15 ml-2 community-panel-description">Bug reports or any feedback for the devs are deeply appreciated!</span>
        </h5>
        <div class="card-body">
          <div class="inbox-widget messages" id="community-messages">
            <div :if={@preview && @messages == []} class="community-empty">The message board is quiet. Share your feedback or ask a question below.</div>
            <%= for message <- @messages do %>
              <div class="inbox-item" id={"community-message-#{message.id}"}>
                <div class="inbox-item-img">
                  <img src={"/images/pve/#{message.tier}.png"} />
                </div>
                <p class="inbox-item-author">
                  <.link
                    navigate={preview_path(assigns, ~p"/player/#{message.user_id}")}
                    class={if(message.is_admin, do: "text-danger", else: "text-dark")}
                  >
                    {message.author}
                  </.link>
                  <%= if message.is_admin do %>
                    <small class="text-danger community-admin">(admin)</small>
                  <% end %>
                </p>
                <div class="inbox-item-text">{formatted_body(message)}</div>
                <p class="inbox-item-date">
                  <%= if @is_admin do %>
                    <a
                      href="javascript:void(0)"
                      phx-click="delete-message"
                      phx-value-id={message.id}
                      class="text-left text-danger float-right small ml-3"
                    >
                      Delete
                    </a>
                  <% end %>
                </p>
              </div>
            <% end %>
          </div>
          <%= unless @current_player.status == "silenced" do %>
            <hr :if={!@preview} class="my-2" />
            <.form for={@form} phx-submit="create-message" id="community-message-form" class="form-horizontal community-composer" phx-hook="ResetFormOnEvent" data-reset-event="community-message-sent">
              <div class="community-compose-field">
              <label :if={@preview} for="community-message-body">Share a message</label>
              <input
                type="text"
                id="community-message-body"
                name={@form[:body].name}
                class="form-control"
                placeholder={
                  if is_nil(@current_player.user),
                    do: "Create an account to send messages",
                    else: "Type and press Enter to send"
                }
                maxlength="500"
                minlength="2"
                disabled={is_nil(@current_player.user)}
              />
              </div>
              <button :if={@preview} type="submit" class="btn base-secondary" disabled={is_nil(@current_player.user)} phx-disable-with="Sending…">Send</button>
            </.form>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card mb-0 community-panel community-announcements" id="community-announcements">
        <h5 class="card-header font-17 text-white community-panel-heading">
          <i class="ui-icon ui-globe mr-1"></i>
          <span class="community-panel-title">Updates</span>
          <span class="text-muted font-italic font-15 ml-2 community-panel-description">
            Stay up to date with the latest development updates in BrowserMOBA
          </span>
        </h5>
        <div class="card-body updates">
          <div :if={@preview && @updates == []} class="community-empty">No development updates yet.</div>
          <ul class="list-unstyled timeline-sm" id="community-updates">
            <%= for update <- @updates do %>
              <li class="timeline-sm-item" id={"community-update-#{update.id}"}>
                <%= if @is_admin do %>
                  <a
                    href="javascript:void(0)"
                    phx-click="delete-message"
                    phx-value-id={update.id}
                    class="text-left text-danger float-right small ml-3"
                  >
                    Delete
                  </a>
                <% end %>
                <h5 class="mt-0 mb-1">{update.title}</h5>
                <div class="text-muted mt-2 community-update-body">{formatted_body(update)}</div>
              </li>
            <% end %>
          </ul>
          <%= if @is_admin do %>
            <hr />
            <.form for={@form} phx-submit="create-update" id="community-update-form" class="form-horizontal" phx-hook="ResetFormOnEvent" data-reset-event="community-update-sent">
              <label :if={@preview} for="community-update-title">Update title</label>
              <input type="text" id="community-update-title" name={@form[:title].name} class="form-control" />
              <br />
              <label :if={@preview} for="community-update-body">Announcement</label>
              <textarea id="community-update-body" name={@form[:body].name} class="form-control" rows="10"></textarea>
              <br />
              <button type="submit" class={["btn", if(@preview, do: "base-secondary", else: "btn-primary btn-sm")]}>Submit</button>
            </.form>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="row mt-3 community-rankings">
    <div class="col text-center">
      <ul class="nav nav-tabs nav-bordered nav-justified community-tabs" role="tablist" aria-label="Community rankings">
        <li class="nav-item">
          <a
            href="javascript:;"
            class={"h5 mt-0 nav-link #{if @active_tab == "online", do: "active"}"}
            phx-click="show-online"
            phx-hook={if @active_tab != "online", do: "Loading"}
            id="show-online-link"
            role="tab"
            aria-selected={to_string(@active_tab == "online")}
            aria-controls="community-online"
          >
            <span class="loading-text f-rpg">
              <i class={"ui-icon ui-users ui-2x text-#{if @active_tab == "online", do: "success", else: "white"}"}></i>
              <br :if={!@preview} />{if @preview, do: "Recent players", else: "RECENT PLAYERS"}
            </span>
          </a>
        </li>
        <li class="nav-item">
          <a
            href="javascript:;"
            class={"h5 mt-0 nav-link #{if @active_tab == "pvp", do: "active"}"}
            phx-click="show-pvp"
            phx-hook={if @active_tab != "pvp", do: "Loading"}
            id="show-pvp-link"
            role="tab"
            aria-selected={to_string(@active_tab == "pvp")}
            aria-controls="community-pvp"
          >
            <span class="loading-text f-rpg">
              <i class={"ui-icon ui-trophy ui-2x text-#{if @active_tab == "pvp", do: "success", else: "white"}"}></i>
              <br :if={!@preview} />{if @preview, do: "Top players", else: "TOP PLAYERS"}
            </span>
          </a>
        </li>
        <li class="nav-item">
          <a
            href="javascript:;"
            class={"h5 mt-0 nav-link #{if @active_tab == "pve", do: "active"}"}
            phx-click="show-pve"
            phx-hook={if @active_tab != "pve", do: "Loading"}
            id="show-pve-link"
            role="tab"
            aria-selected={to_string(@active_tab == "pve")}
            aria-controls="community-pve"
          >
            <span class="loading-text f-rpg">
              <i class={"ui-icon ui-helmet ui-2x text-#{if @active_tab == "pve", do: "success", else: "white"}"}></i>
              <br :if={!@preview} />{if @preview, do: "Top heroes", else: "TOP HEROES"}
            </span>
          </a>
        </li>
      </ul>
      <div :if={@active_tab == "online"} class="mt-2 mb-2" id="community-online" role="tabpanel" aria-labelledby="show-online-link">
        <div :if={@is_admin} class="row mt-3">
          <div class="col-xl-3 col-md-6">
            <div class="widget-simple text-center card-box" phx-click="user-filter">
              <h3 class="text-success counter mt-0">{@user_stats.new_guests}</h3>
              <p class="text-muted mb-0">New Guests</p>
            </div>
          </div>

          <div class="col-xl-3 col-md-6">
            <div class="widget-simple text-center card-box" phx-click="user-filter">
              <h3 class="text-primary counter mt-0">
                {@user_stats.new_users}
                <%= if @user_stats.new_guests > 0 do %>
                  ({div(@user_stats.new_users * 100, @user_stats.new_guests)}%)
                <% end %>
              </h3>
              <p class="text-muted mb-0">New Users (% converted)</p>
            </div>
          </div>

          <div class="col-xl-3 col-md-6">
            <div class="widget-simple text-center card-box" phx-click="user-filter">
              <h3 class="text-pink mt-0 counter">
                {@user_stats.online_today}
                <%= if @user_stats.online_today > 0 do %>
                  ({div(@user_stats.new_users * 100, @user_stats.online_today)}%)
                <% end %>
              </h3>
              <p class="text-muted mb-0">
                Online {if @user_filter == :daily, do: "Today", else: "This Week"} (% new)
              </p>
            </div>
          </div>

          <div class="col-xl-3 col-md-6">
            <div class="widget-simple text-center card-box" phx-click="user-filter">
              <h3 class="text-danger counter mt-0">
                {@user_stats.new_heroes}
                <%= if @user_stats.online_today > 0 do %>
                  ({Float.round(@user_stats.new_heroes / @user_stats.online_today, 1)}x)
                <% end %>
              </h3>
              <p class="text-muted mb-0">New Heroes (x online)</p>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col">
            <table class="table table-dark mb-0 ranking border-left border-right border-bottom">
              <tbody id="hall-of-training">
                <tr class="f-rpg font-17 text-white">
                  <th
                    class="border"
                    width="10%"
                    phx-click={if @current_player.user && @current_player.user.is_admin, do: "toggle-admin"}
                  >
                    Player
                  </th>
                  <th class="border" width="10%">Arena</th>
                  <th class="border text-left">
                    <div class="ml-4">LATEST HEROES</div>
                  </th>
                </tr>
                <%= for player <- @players do %>
                  <.player_row preview={Map.get(assigns, :preview, false)} player={player} is_admin={@is_admin} current={player.id == @current_player.id} />
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="row mt-3">
          <%= for player <- @guests do %>
            <.guest
              :if={player.current_pve_hero}
              is_admin={@is_admin}
              player={player}
              current={player.id == @current_player.id}
            />
          <% end %>
        </div>
        <div :if={@is_admin} class="row">
          <div class="col">
            <div class="card">
              <div class="card-body p-0 pt-2">
                <h2 class="text-center mt-0 mb-0">Arena Stats</h2>
                <h5 class="text-center">
                  Avg Winrate: {Float.round(@match_stats.winrate, 1)}%
                  <small>({@match_stats.total} total matches)</small>
                </h5>
                <ul class="nav nav-pills navtab-bg mt-2 mb-2 justify-content-center">
                  <li class="nav-item">
                    <a
                      href="javascript:;"
                      phx-click="match-filter"
                      phx-value-type="pvp"
                      data-toggle="tab"
                      class={"nav-link px-2 py-1 #{if @match_filter == "pvp", do: "active"}"}
                      phx-hook="Loading"
                      id="immortal-ranking-button"
                    >
                      <span class="d-inline-block loading-text">All</span>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a
                      href="javascript:;"
                      phx-click="match-filter"
                      phx-value-type="plebs"
                      data-toggle="tab"
                      class={"nav-link px-2 py-1 #{if @match_filter == "plebs", do: "active"}"}
                      phx-hook="Loading"
                      id="pleb-ranking-button"
                    >
                      <span class="d-inline-block loading-text">Plebs</span>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a
                      href="javascript:;"
                      phx-click="match-filter"
                      phx-value-type="elite"
                      data-toggle="tab"
                      class={"nav-link px-2 py-1 #{if @match_filter == "elite", do: "active"}"}
                      phx-hook="Loading"
                      id="elite-ranking-button"
                    >
                      <span class="d-inline-block loading-text">Elite</span>
                    </a>
                  </li>
                </ul>
                <div class="row">
                  <div class="col">
                    <div>
                      <div class="row no-gutters">
                        <div class="col">
                          <.arena_stats
                            records={top_performing(@match_stats, :avatars)}
                            key={:avatars}
                            match_filter={@match_filter}
                          />
                        </div>
                        <div class="col">
                          <.arena_stats
                            records={bottom_performing(@match_stats, :avatars)}
                            key={:avatars}
                            match_filter={@match_filter}
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col">
                    <div>
                      <div class="row no-gutters">
                        <div class="col">
                          <.arena_stats
                            records={top_performing(@match_stats, :skills)}
                            key={:skills}
                            match_filter={@match_filter}
                          />
                        </div>
                        <div class="col">
                          <.arena_stats
                            records={bottom_performing(@match_stats, :skills)}
                            key={:skills}
                            match_filter={@match_filter}
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <h5 class="text-center">
                  Avg Winrate: {Float.round(@match_stats.winrate, 1)}%
                  <small>({@match_stats.total} total matches)</small>
                </h5>
                <div class="row">
                  <div class="col-md-6 margin-auto">
                    <div>
                      <div class="row no-gutters">
                        <div class="col">
                          <.arena_stats
                            records={top_performing(@match_stats, :items)}
                            key={:items}
                            match_filter={@match_filter}
                          />
                        </div>
                        <div class="col">
                          <.arena_stats
                            records={bottom_performing(@match_stats, :items)}
                            key={:items}
                            match_filter={@match_filter}
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div :if={@is_admin} class="row mt-3">
          <div class="col-xl-6 col-lg-8 margin-auto col-xs-12">
            <table class="table table-dark mb-0 border-left border-right border-bottom text-center">
              <%= for duel <- @duels do %>
                <tr>
                  <td>
                    <h5><.link navigate={preview_path(assigns, ~p"/arena/#{duel}")}>Duel {duel.id}</.link></h5>
                  </td>
                  <td>
                    {duel.inserted_at |> Timex.format("{relative}", :relative) |> elem(1)}
                  </td>
                  <td>
                    <img src={"/images/pve/#{duel.player.pve_tier}.png"} style="max-height:  40px" /><br />
                    {username(duel.player)}
                  </td>
                  <td style="width: 1%">
                    vs
                  </td>
                  <td>
                    <img src={"/images/pve/#{duel.opponent_player.pve_tier}.png"} style="max-height:  40px" /><br />
                    {username(duel.opponent_player)}
                  </td>
                  <td>
                    <%= if duel.phase == "finished" do %>
                      <%= if duel.winner_player do %>
                        <span class="text-success">Winner: {username(duel.winner_player)}</span>
                      <% else %>
                        <span class="text-muted">Tie</span>
                      <% end %>
                      <br />
                      <%= if duel.rewards.attacker_pvp_points > 0 do %>
                        <span class="badge badge-pill badge-light-success">
                          {username(duel.player)}: +{duel.rewards.attacker_pvp_points}
                        </span>
                      <% else %>
                        <span class="badge badge-pill badge-light-dark">
                          {username(duel.player)}: {duel.rewards.attacker_pvp_points}
                        </span>
                      <% end %>
                      <%= if duel.rewards.defender_pvp_points != 0 do %>
                        <%= if duel.rewards.defender_pvp_points > 0 do %>
                          <span class="badge badge-pill badge-light-success">
                            {username(duel.opponent_player)}: +{duel.rewards.defender_pvp_points}
                          </span>
                        <% else %>
                          <span class="badge badge-pill badge-light-dark">
                            {username(duel.opponent_player)}: {duel.rewards.defender_pvp_points}
                          </span>
                        <% end %>
                      <% end %>
                    <% else %>
                      <span class="text-danger">In progress</span>
                    <% end %>
                  </td>
                  <td>
                    <%= if duel.auto do %>
                      <span class="text-muted">Auto</span>
                    <% else %>
                      <span class="text-danger">Live</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </table>
          </div>
        </div>
      </div>
      <div :if={@active_tab == "pvp"} class="mt-1 mb-1" id="community-pvp" role="tabpanel" aria-labelledby="show-pvp-link">
        <div class="row">
          <%= for player <- @pvp_ranking do %>
            <.player_card preview={Map.get(assigns, :preview, false)} player={player} />
          <% end %>
        </div>
      </div>
      <div :if={@active_tab == "pve"} class="mt-1 mb-1" id="community-pve" role="tabpanel" aria-labelledby="show-pve-link">
        <div class="row">
          <%= for hero <- @pve_ranking do %>
            <.pve_hero_card preview={Map.get(assigns, :preview, false)} hero={hero} />
          <% end %>
        </div>
      </div>
    </div>
  </div>
  </div>
</Layouts.app>
