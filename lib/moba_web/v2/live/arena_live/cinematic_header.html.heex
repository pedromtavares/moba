<header id="pvp-progression" class="arena-cinematic" style="--arena-scene: url(/images/tutorial/arena-of-ascension.jpg)">
  <div class="arena-cinematic-heading">
    <div>
      <p class="arena-eyebrow">The proving ground · 5v5</p>
      <h1>Arena</h1>
      <p id="current-pvp-tier">{tier_title(@current_player)}</p>
    </div>
    <span :if={tier_buff_pct(@current_player)} class="arena-handicap">
      −{tier_buff_pct(@current_player)}% Hero Stats
    </span>
  </div>
  <div class="arena-cinematic-command">
    <div class="arena-daily-progress">
      <div class="arena-progress-label" id="arena-progress-label">
        <span>Daily matches</span>
        <strong>{@current_player.daily_matches}<span> / {Moba.daily_match_limit()}</span></strong>
      </div>
      <div class="progress" id="daily-progression" role="progressbar" aria-labelledby="arena-progress-label" aria-valuemin="0" aria-valuemax={Moba.daily_match_limit()} aria-valuenow={@current_player.daily_matches}>
        <div style={"width:#{manual_matches_percentage(@manual_matches)}%;"} class="progress-bar manual-bar" title={"Manual matches played: #{length(@manual_matches)}"}></div>
        <div style={"width:#{auto_matches_percentage(@auto_matches)}%;"} class="progress-bar auto-bar" title={"Auto matches played: #{length(@auto_matches)}"}></div>
      </div>
      <div class="arena-progress-legend">
        <span><span class="legend-dot manual"></span>{length(@manual_matches)} manual</span>
        <span><span class="legend-dot automatic"></span>{length(@auto_matches)} automatic</span>
      </div>
    </div>
    <div class="arena-cinematic-action">
      <%= cond do %>
        <% @pending_match -> %>
          <.link id="resume-arena-match" navigate={preview_path(assigns, ~p"/matches/#{@pending_match}")} class="btn battle-primary arena-resume-match">
            Resume match <span aria-hidden="true">→</span>
          </.link>
        <% length(@manual_matches) < Moba.daily_match_limit() -> %>
          <button type="button" phx-click="matchmaking" class="btn battle-primary" id="enter-arena-button">
            <span class="loading-text">Enter the Arena <span aria-hidden="true">→</span></span>
          </button>
          <p class="arena-entry-reward" id="arena-entry-reward">
            <span>Match reward</span><strong>◆ +{Moba.matchmaking_shards()} Shards</strong>
          </p>
        <% true -> %>
          <div id="arena-daily-limit" class="arena-daily-limit">
            <strong>Daily matches complete</strong><span>{daily_reset_label()}</span>
          </div>
      <% end %>
    </div>
  </div>
  <div class="arena-cinematic-footer" id="arena-header-footer">
    <dl class="arena-cinematic-stats">
      <div><dt>Season points</dt><dd class="arena-stat-gold">{@current_player.pvp_points}</dd></div>
      <div title={"Total Matches: #{@current_player.total_matches}. Total Wins: #{@current_player.total_wins}"}>
        <dt>Total win rate</dt><dd class="arena-stat-blue">{total_win_rate(@current_player)}<small>%</small></dd>
      </div>
      <div><dt>Daily wins</dt><dd class="arena-stat-green">{@current_player.daily_wins}</dd></div>
    </dl>
    <button :if={!@pending_duel} id="season-duel-button" type="button" phx-click="season-duel" class="btn base-secondary arena-season-duel">
      <span class="loading-text"><.icon name="game-attack" /> Play a Season Duel <span aria-hidden="true">→</span></span>
    </button>
  </div>
</header>
