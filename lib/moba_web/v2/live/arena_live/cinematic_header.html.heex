<header id="pvp-progression" class="arena-cinematic" style="--arena-scene: url(/images/tutorial/arena-of-ascension.jpg)">
  <div class="arena-cinematic-heading">
    <div>
      <h1>PvP Arena</h1>
      <p id="current-pvp-tier">{tier_title(@current_player)}</p>
    </div>
  </div>
  <div class="arena-cinematic-command">
    <div class="arena-daily-progress">
      <div class="arena-progress-label" id="arena-progress-label">
        <div class="arena-progress-caption">
          <span id="arena-daily-matches-title">Daily 3v3 matches</span>
          <span class="arena-reset-countdown">
            <.icon name="game-clock" />
            <span
              id="arena-reset-countdown"
              role="timer"
              phx-hook="ArenaResetCountdown"
              phx-update="ignore"
              data-reset-at={@daily_reset_at && DateTime.to_unix(@daily_reset_at, :millisecond)}
            >
              {daily_reset_label(@daily_reset_at)}
            </span>
          </span>
        </div>
        <strong>{@current_player.daily_matches}<span> / {Moba.daily_match_limit()}</span></strong>
      </div>
      <div
        class="progress"
        id="daily-progression"
        role="progressbar"
        aria-labelledby="arena-daily-matches-title"
        aria-valuemin="0"
        aria-valuemax={Moba.daily_match_limit()}
        aria-valuenow={min(@current_player.daily_matches, Moba.daily_match_limit())}
      >
        <div
          style={"width:#{match_progress_percentage(@manual_matches, @auto_matches)}%;"}
          class="progress-bar manual-bar"
          title={"Manual matches played: #{length(@manual_matches)}"}
        >
        </div>
        <div
          style={"width:#{match_progress_percentage(@auto_matches, @manual_matches)}%;"}
          class="progress-bar auto-bar"
          title={"Auto matches played: #{length(@auto_matches)}"}
        >
        </div>
      </div>
      <div class="arena-progress-legend">
        <span><span class="legend-dot manual"></span>{length(@manual_matches)} manual</span>
        <span><span class="legend-dot automatic"></span>{length(@auto_matches)} automatic</span>
      </div>
    </div>
    <div class="arena-cinematic-action">
      <div class="arena-play-actions" aria-label="Play in the Arena">
        <div class="arena-play-mode arena-play-3v3">
          <%= if @pending_match do %>
            <.link
              id="resume-arena-match"
              navigate={preview_path(assigns, ~p"/matches/#{@pending_match}")}
              class="btn battle-primary arena-play-button"
            >
              <.icon name="game-arena-3v3" /><span>Resume 3v3</span><span aria-hidden="true">→</span>
            </.link>
          <% else %>
            <% limit_reached? = manual_match_limit_reached?(@current_player, @manual_matches) %>
            <button
              id="enter-arena-button"
              type="button"
              data-game-fullscreen
              phx-click="matchmaking"
              class="btn battle-primary arena-play-button"
              disabled={limit_reached?}
            >
              <span class="loading-text">
                <.icon name="game-arena-3v3" />
                <span>{if limit_reached?, do: "3v3 daily limit reached", else: "Play 3v3"}</span>
                <span :if={!limit_reached?} aria-hidden="true">→</span>
              </span>
            </button>
          <% end %>
          <.arena_streak_penalty player={@current_player} />
        </div>
        <div class="arena-play-mode arena-play-1v1">
          <%= if @pending_duel do %>
            <.link
              id="resume-arena-duel"
              navigate={preview_path(assigns, ~p"/arena/#{@pending_duel}")}
              class="btn battle-primary arena-play-button"
            >
              <.icon name="game-swords" /><span>Resume 1v1</span><span aria-hidden="true">→</span>
            </.link>
          <% else %>
            <button
              id="season-duel-button"
              type="button"
              data-game-fullscreen
              phx-click="season-duel"
              class="btn battle-primary arena-play-button"
              disabled={@current_player.status == "silenced"}
            >
              <span class="loading-text">
                <.icon name="game-swords" /><span>Play 1v1</span><span aria-hidden="true">→</span>
              </span>
            </button>
          <% end %>
        </div>
      </div>
      <p :if={@reward_games < Moba.daily_match_limit()} class="arena-entry-reward" id="arena-entry-reward">
        <strong>◆ +{Moba.matchmaking_shards()} Shards</strong><span>per game</span>
      </p>
    </div>
  </div>
  <div class="arena-cinematic-footer" id="arena-header-footer">
    <dl class="arena-cinematic-stats">
      <div>
        <dt>Arena Rating</dt>
        <dd class="arena-stat-gold">{@current_player.pvp_points}</dd>
      </div>
      <div title={GH.win_rate_summary(@recent_results)}>
        <dt>3v3 Win Rate</dt>
        <dd class="arena-stat-blue">{GH.win_rate(@recent_results)}<small>%</small></dd>
      </div>
      <div>
        <dt>Daily 3v3 wins</dt>
        <dd class="arena-stat-green">{@current_player.daily_wins}</dd>
      </div>
    </dl>
  </div>
</header>
