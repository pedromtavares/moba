<% position = if @mode == "3v3", do: @player.ranking || @index, else: @index %>
<.link
  navigate={preview_path(assigns, ~p"/player/#{@player.id}")}
  data-profile-username={Moba.Utils.username(@player)}
  class="arena-standing-row"
  data-bracket={if @mode == "3v3", do: arena_bracket(@player)}
  aria-current={if @player.id == @current_player.id, do: "true"}
  title={"#{@player.pvp_points} Arena Rating"}
>
  <span class="arena-standing-position">
    <%= if position do %>
      <span><small>#</small>{position}</span>
    <% else %>
      <span aria-label={if @mode == "3v3", do: "Unranked", else: "Outside leaderboard"}>—</span>
    <% end %>
    <.standing_movement movement={@movement} />
  </span>
  <img src={"/images/pve/#{@player.pve_tier}.png"} alt="" class="arena-standing-emblem" />
  <span class="arena-standing-identity">
    <strong>{username(@player)}</strong>
    <span :if={@mode == "3v3"} class="arena-standing-meta">
      <span class="arena-standing-bracket">{arena_bracket(@player)}</span>
      <span>· {@player.daily_matches} {if @player.daily_matches == 1, do: "match", else: "matches"} played</span>
    </span>
  </span>
  <span class="arena-standing-score">
    <strong>{if @mode == "3v3", do: @player.daily_wins, else: @player.pvp_points}</strong><span>{if @mode == "3v3", do: "daily wins", else: "Arena Rating"}</span>
  </span>
</.link>
