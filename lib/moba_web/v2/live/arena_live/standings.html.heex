<section id="arena-standings" class="card ranking arena-standings" aria-labelledby="arena-standings-title">
  <header class="arena-standings-heading">
    <h2 id="arena-standings-title" class="sr-only">
      {if @ranking_tab == "5v5", do: "Daily ranking", else: "Season points ranking"}
    </h2>
    <div id="arena-standings-switcher" class="arena-history-switcher" role="group" aria-label="Leaderboard mode">
      <button
        :for={mode <- ["5v5", "1v1"]}
        id={"arena-standings-#{mode}"}
        type="button"
        phx-click="standings-tab"
        phx-value-type={mode}
        aria-pressed={to_string(@ranking_tab == mode)}
        aria-controls="arena-standings-list"
      >
        {mode}
      </button>
    </div>
  </header>
  <ol
    id="arena-standings-list"
    class="arena-standings-list"
    aria-label={if @ranking_tab == "5v5", do: "Daily ranking", else: "Season points descending"}
  >
    <li
      :for={{player, index} <- Enum.with_index(@ranking, 1)}
      id={"standing-player-#{player.id}"}
      class={player.id == @current_player.id && "is-you"}
    >
      <.standing_row
        player={player}
        index={index}
        mode={@ranking_tab}
        movement={if @ranking_tab == "5v5", do: arena_movement(player, @ranking)}
        current_player={@current_player}
        preview={@preview}
      />
    </li>
  </ol>
  <p :if={@ranking == []} id="arena-standings-empty" class="arena-standings-empty">No ranked players yet.</p>
  <footer :if={!ranking_inclusion?(@ranking, @current_player)} id="arena-your-standing" class="arena-your-standing">
    <p>Your standing</p>
    <.standing_row
      player={@current_player}
      index={nil}
      mode={@ranking_tab}
      movement={if @ranking_tab == "5v5", do: arena_movement(@current_player, @ranking)}
      current_player={@current_player}
      preview={@preview}
    />
  </footer>
</section>
