<table id="profile-hero-ranking-table" class="table table-dark ranking-table m-0 profile-leaderboard-table">
  <colgroup><col class="profile-rank-column" /><col /><col class="profile-score-column" /></colgroup>
  <thead class="sr-only">
    <tr>
      <th scope="col">Hero rank</th>
      <th scope="col">Hero and player</th>
      <th scope="col">Training time</th>
    </tr>
  </thead>
  <tbody data-listing-rows>
    <tr
      :for={hero <- @hero_ranking}
      id={"profile-ranked-hero-#{hero.id}"}
      class={hero.player_id == @player.id && "selected-player"}
      data-profile-hero={to_string(hero.player_id == @player.id)}
    >
      <td class="profile-hero-position">
        <h1 class="f-rpg">#{hero.pve_ranking}</h1>
      </td>
      <td>
        <.link navigate={preview_path(assigns, ~p"/hero/#{hero.id}")} class="profile-ranked-identity">
          <img src={GH.image_url(hero.avatar)} alt="" class="profile-ranked-avatar" loading="lazy" />
          <span>
            <strong class="profile-ranked-name">{hero.name}</strong><small class="profile-ranking-detail">{hero.avatar.name} · {username(hero.player)}</small>
          </span>
        </.link>
      </td>
      <td class="profile-training-time">
        <% minutes = GH.finished_time(hero) %>
        <h3 class="text-success" aria-label={if is_nil(minutes), do: "Time unavailable"}>
          {GH.minutes_label(minutes, @preview) || "—"}
        </h3>
        <small :if={is_integer(minutes)} class="profile-ranking-unit">min</small>
      </td>
    </tr>
  </tbody>
</table>
<p :if={@hero_ranking == []} id="profile-no-ranked-heroes" class="profile-rank-empty">No ranked heroes yet.</p>
