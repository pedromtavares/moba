<table id="profile-team-ranking-table" class="table table-dark ranking-table m-0 profile-leaderboard-table">
  <colgroup><col class="profile-rank-column" /><col /><col class="profile-score-column" /></colgroup>
  <thead class="sr-only">
    <tr>
      <th scope="col">Team rank</th>
      <th scope="col">Team</th>
      <th scope="col">Training time</th>
    </tr>
  </thead>
  <tbody>
    <tr
      :for={%{team: team, position: position} <- @team_ranking}
      id={"profile-ranked-team-#{team.id}"}
      class={team.player_id == @player.id && "selected-player"}
      phx-hook={if team.id == @best_team_rank[:id], do: "HalfScroll"}
      phx-container="#user-ranking"
    >
      <td>
        <h1 class="f-rpg">#{position}</h1>
      </td>
      <td>
        <.link navigate={preview_path(assigns, ~p"/teams/#{team.id}")} class="profile-ranked-identity">
          <span class="profile-ranked-team-portraits" aria-hidden="true">
            <img :for={hero <- team.heroes} src={GH.image_url(hero.avatar)} alt="" loading="lazy" />
          </span>
          <span>
            <strong class="profile-ranked-name">{MobaWeb.V2.Components.TeamComponents.display_name(team)}</strong>
            <small class="profile-ranking-detail">{Enum.map_join(team.heroes, " · ", & &1.avatar.name)}</small>
          </span>
        </.link>
      </td>
      <td class="profile-training-time" title={if team.duration_seconds, do: "#{team.duration_seconds} seconds"}>
        <h3 class="text-success" aria-label={if is_nil(team.duration_seconds), do: "Time unavailable"}>
          {if team.duration_seconds, do: GH.minutes_label(div(team.duration_seconds, 60), @preview), else: "—"}
        </h3>
        <small :if={is_integer(team.duration_seconds)} class="profile-ranking-unit">min</small>
      </td>
    </tr>
  </tbody>
</table>
<p :if={@team_ranking == []} id="profile-no-ranked-teams" class="profile-rank-empty">No ranked teams yet.</p>
