<Layouts.app
  preview={@preview}
  flash={@flash}
  current_scope={@current_scope}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code="training"
  hide_footer
>
  <main id="battle-history" class="battles">
    <header class="history-heading" style="--history-scene: url(/images/tutorial/training-gateway.jpg)">
      <div class="history-heading-identity">
        <div :if={is_integer(@league_tier)} id="current-training-rank">
          <.league_badge tier={@league_tier} variant="legacy" />
        </div>
        <div>
          <h1>Battle Log</h1>
          <p>
            {@subject}<span :if={is_integer(@league_tier)}> · {GH.league_name(@league_tier)}</span>
          </p>
        </div>
      </div>
      <.link id="history-return-training" class="history-return" navigate={@return_path}>
        <span aria-hidden="true">←</span> Return to Training
      </.link>
    </header>

    <.history_modern sections={@sections} history_tab={@history_tab} />
  </main>
</Layouts.app>
