<Layouts.app
  preview={@preview}
  flash={@flash}
  current_scope={@current_scope}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code={@sidebar_code}
  hide_footer
>
  <main class="tavern catalog-viewport" id="tavern">
    <header class="tavern-heading" id="tavern-heading" style="--tavern-scene: url(/images/tutorial/hall-of-legends.jpg)">
      <div>
        <span class="tavern-eyebrow">Your collection</span>
        <h1>Tavern</h1>
        <p class="tavern-heading-description">New avatars. New abilities. New possibilities.</p>
      </div>
      <p class="tavern-heading-guide">Earn Shards in Training and the Arena.<br />Unlock avatars and skins below.</p>
      <div class="tavern-balance" id="tavern-shards">
        <strong><.icon name="game-shard" />{@current_player.user.shard_count}</strong>
        <span>Shards available</span>
      </div>
    </header>

    <div class="cinematic-catalog-tabs" role="tablist" aria-label="Tavern collection">
      <button
        :for={
          {key, label, icon, tone} <- [
            {"avatars", "Avatars", "nav-profile", nil},
            {"skins", "Skins", "nav-catalog-skins", "violet"}
          ]
        }
        type="button"
        id={"show-#{key}-link"}
        class={@active_tab == key && "active"}
        data-catalog-tone={tone}
        phx-click={"show-#{key}"}
        role="tab"
        aria-selected={to_string(@active_tab == key)}
        aria-controls={"tavern-#{key}"}
      >
        <.icon name={icon} />{label}
      </button>
    </div>

    <section
      :if={@active_tab == "avatars"}
      id="tavern-avatars"
      class="tavern-catalog-panel"
      role="tabpanel"
      aria-labelledby="show-avatars-link"
    >
      <.tavern_avatar_card
        :if={@selected_avatar}
        avatar={@selected_avatar}
        avatars={@all_avatars}
        player={@current_player}
        featured={@selected_avatar == @featured_avatar}
      />
      <p :if={!@selected_avatar} class="tavern-catalog-empty">No avatars available to unlock.</p>
      <.tavern_roster avatars={@avatars} selected={@selected_avatar} event="browse-avatar" />
    </section>

    <section
      :if={@active_tab == "skins"}
      id="tavern-skins"
      class="tavern-catalog-panel"
      role="tabpanel"
      aria-labelledby="show-skins-link"
    >
      <%= if @current_skin do %>
        <div class="tavern-skin-stage">
          <div class="tavern-skin-art" style={"--skin-art: url(#{GH.background_url(@current_skin)})"}>
            <img src={GH.background_url(@current_skin)} alt={@current_skin.name} />
          </div>
          <div class="tavern-catalog-readout">
            <div>
              <div class="tavern-skin-league">
                <img src={"/images/league/#{@current_skin.league_tier}.png"} alt="" />
                {Moba.leagues()[@current_skin.league_tier]}
              </div>
              <h2>{@current_skin.name}</h2>
              <a href={@current_skin.author_link} target="_blank" rel="noopener noreferrer" class="tavern-skin-author">
                by {@current_skin.author_name}
              </a>
            </div>
            <div class="tavern-skin-nav" aria-label="Browse skins">
              <button type="button" phx-click="previous-skin" aria-label="Previous skin" disabled={@current_index == 0}>
                ←
              </button>
              <span>{@current_index + 1} / {length(@current_skins)}</span>
              <button
                type="button"
                phx-click="next-skin"
                aria-label="Next skin"
                disabled={@current_index + 1 >= length(@current_skins)}
              >
                →
              </button>
            </div>
            <div
              :if={unlocked?(@current_skin, @current_player)}
              class="tavern-owned"
              title="You can select this skin when joining the Arena with this hero."
            >
              <i class="ui-icon ui-unlock" aria-hidden="true"></i> Unlocked
            </div>
            <.tavern_unlock_actions
              :if={!unlocked?(@current_skin, @current_player)}
              resource={@current_skin}
              player={@current_player}
              action="unlock-skin"
            />
          </div>
        </div>
      <% else %>
        <p class="tavern-catalog-empty">
          {if @current_avatar, do: "No skins available for #{@current_avatar.name}.", else: "No skins available."}
        </p>
      <% end %>
      <.tavern_roster avatars={@all_avatars} selected={@current_avatar} event="set-avatar" />
    </section>
  </main>
</Layouts.app>
