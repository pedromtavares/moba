<%!-- PvE Progression --%>
<div id="pve-progression" class="bg-surface border border-surface-border rounded p-4 mb-4">
  <%= if @next_pve_tier do %>
    <div class="flex items-center justify-between gap-4">
      <%!-- Current tier --%>
      <div class="text-center flex-shrink-0 w-24">
        <img src={"/images/pve/#{@current_player.pve_tier}.png"} class="w-16 h-16 mx-auto" loading="lazy" />
        <div class="text-white font-bold uppercase text-sm mt-1">
          <%= GH.pve_tier_name(@current_player.pve_tier) %>
        </div>
      </div>

      <%!-- Quest progress --%>
      <div class="flex-1 text-center">
        <h4 class="text-faction-text text-sm mb-3">
          <%= current_quest_description(@current_player) %>
        </h4>
        <div title={quest_avatars_title(@current_player)}>
          <.progress_bar
            value={quest_progression_pct(@current_player)}
            label={quest_progression_label(@current_player)}
            class="h-10 text-sm cursor-help"
          />
        </div>
        <div class="mt-3">
          <%= if @current_player.pvp_tier != Moba.max_pvp_tier() do %>
            <.button variant="secondary" phx-click="toggle-rewards">
              Progression Rewards
            </.button>
          <% end %>
        </div>
      </div>

      <%!-- Next tier --%>
      <div class="text-center flex-shrink-0 w-24">
        <img src={"/images/pve/#{@next_pve_tier}.png"} class="w-16 h-16 mx-auto" loading="lazy" />
        <div class="text-white font-bold uppercase text-sm mt-1">
          <%= GH.pve_tier_name(@next_pve_tier) %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center">
      <img src={"/images/pve/#{@current_player.pve_tier}.png"} class="w-28 h-28 mx-auto" loading="lazy" />
      <div class="text-white font-bold uppercase text-xl mt-2">
        <%= GH.pve_tier_name(@current_player.pve_tier) %>
      </div>
    </div>
  <% end %>
</div>

<%!-- Progression Rewards (inline panel, replaces Bootstrap modal) --%>
<%= if @show_rewards && @next_pve_tier do %>
  <div id="pve-tier-rewards" class="bg-surface border border-surface-border rounded p-4 mb-4">
    <div class="text-center mb-3">
      <img src={"/images/pve/#{@next_pve_tier}.png"} class="w-14 h-14 mx-auto" loading="lazy" />
      <h3 class="text-gold font-bold mt-1"><%= GH.pve_tier_name(@next_pve_tier) %></h3>
      <div class="text-faction-text-muted text-xs">Progression Rewards</div>
    </div>
    <table class="w-full text-sm">
      <tbody>
        <tr class="border-t border-surface-border">
          <td class="py-2 pr-4 text-atk font-medium w-2/5">⚔ Training Difficulty</td>
          <td class="py-2 text-faction-text"><%= training_difficulty_for(@next_pve_tier) %></td>
        </tr>
        <%= if bonus = training_bonus_for(@next_pve_tier) do %>
          <tr class="border-t border-surface-border">
            <td class="py-2 pr-4 text-hp font-medium w-2/5">⚔ Training Bonus</td>
            <td class="py-2 text-faction-text"><%= bonus %></td>
          </tr>
        <% end %>
        <tr class="border-t border-surface-border">
          <td class="py-2 pr-4 text-mp font-medium w-2/5">❋ Farming per Turn</td>
          <td class="py-2 text-faction-text"><%= GH.farming_per_turn_label(@next_pve_tier) %></td>
        </tr>
        <tr class="border-t border-surface-border">
          <td class="py-2 pr-4 text-gold font-medium w-2/5">🏆 Maximum League</td>
          <td class="py-2 text-faction-text"><%= max_league_allowed_for(@next_pve_tier) %></td>
        </tr>
        <tr class="border-t border-surface-border">
          <td class="py-2 pr-4 text-mp font-medium w-2/5">
            <.link href="/tavern" class="hover:text-mp-light underline">⟁ Shards</.link>
          </td>
          <td class="py-2 text-gold font-semibold">+ <%= quest_shard_prize(@next_pve_tier) %></td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>

<%!-- Hero List --%>
<div id="hero-list-container" class="bg-surface border border-surface-border rounded">
  <%!-- Train button --%>
  <div class="p-4 text-center">
    <.link
      href="/invoke"
      class="inline-block w-full max-w-sm px-4 py-3 text-base border border-hp/60 text-hp rounded hover:bg-hp/10 transition-colors"
    >
      + Train a new Hero
    </.link>
  </div>

  <%!-- Hero collection --%>
  <div class="flex flex-wrap justify-center gap-x-2 gap-y-3 px-4 pb-4">
    <%= for hero <- (@current_player.hero_collection || []) do %>
      <div class="relative w-[72px] text-center" title={hero["avatar"]["name"]}>
        <img
          src={GH.image_url(hero["avatar"])}
          class={["w-14 h-14 mx-auto rounded object-cover", collection_avatar_class(hero)]}
        />
        <img
          src={"/images/league/#{hero["tier"]}.png"}
          class="absolute bottom-0 right-1 w-5 h-5"
          loading="lazy"
        />
      </div>
    <% end %>
    <%= for avatar <- @blank_collection do %>
      <div class="relative w-[72px] text-center" title={avatar.name}>
        <img
          src={GH.image_url(avatar)}
          class="w-14 h-14 mx-auto rounded object-cover opacity-20 grayscale"
        />
      </div>
    <% end %>
  </div>

  <%!-- Hero grid with filter tabs --%>
  <%= if @hero_count > 0 do %>
    <div class="border-t border-surface-border">
      <%!-- Filter tabs --%>
      <div class="flex justify-center pt-3 px-4">
        <.tab_bar>
          <.tab
            active={@filter == "unfinished"}
            phx-click="filter"
            phx-value-filter="unfinished"
            id="in-progress-heroes-tab"
          >
            In Progress
          </.tab>
          <.tab
            active={@filter == "finished"}
            phx-click="filter"
            phx-value-filter="finished"
            id="finished-heroes-tab"
          >
            Finished
          </.tab>
        </.tab_bar>
      </div>

      <%!-- Hero grid --%>
      <div class="p-4" id={"hero-list-#{@filter}"}>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for hero <- @visible_heroes do %>
            <.hero_card hero={hero}>
              <:actions>
                <%!-- Delete --%>
                <%= if can_delete_hero?(hero) do %>
                  <.button
                    variant="danger"
                    phx-click="archive"
                    phx-value-id={hero.id}
                    data-confirm="Are you sure you want to DELETE your hero?"
                    class="text-xs !px-2 !py-1"
                  >
                    Delete
                  </.button>
                <% end %>

                <%!-- Continue / Customize --%>
                <%= if is_nil(hero.finished_at) do %>
                  <.button
                    variant="primary"
                    phx-click="continue"
                    phx-value-id={hero.id}
                    title={"#{hero.pve_total_turns + hero.pve_current_turns} turns left"}
                  >
                    Continue
                  </.button>
                <% else %>
                  <.link
                    href={"/hero/#{hero.id}"}
                    class="inline-flex items-center justify-center px-4 py-2 text-sm bg-surface border border-mp/50 text-mp rounded hover:bg-mp/10 hover:border-mp transition-colors"
                  >
                    Customize
                  </.link>
                <% end %>

                <%!-- Farm + time --%>
                <div class="ml-auto flex items-center gap-2 text-xs text-faction-text-muted">
                  <span
                    title={"Total farm: #{GH.total_farm(hero)}. Gold: #{hero.total_gold_farm}. XP: #{hero.total_xp_farm}"}
                  >
                    👑 <%= GH.farming_amount_label(GH.total_farm(hero)) %>
                  </span>
                  <%= if hero.finished_at do %>
                    <span title="Time to finish Training">
                      🕐 <%= GH.finished_time(hero) %> min
                    </span>
                  <% end %>
                </div>
              </:actions>
            </.hero_card>
          <% end %>
        </div>

        <%!-- Load All --%>
        <%= unless all_loaded?(@loaded, @filter) do %>
          <div class="mt-4">
            <.button
              variant="secondary"
              phx-click="load-all"
              class="w-full"
              id={"load-all-heroes-#{@filter}"}
            >
              + Load All
            </.button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
