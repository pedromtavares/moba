<Layouts.app
  preview={@preview}
  flash={@flash}
  current_scope={@current_scope}
  current_player={@current_player}
  current_hero={@current_hero}
  sidebar_code={@sidebar_code}
>
  <div class={["dashboard", if(@preview, do: "base-page", else: "mt-2")]} id="base-page">
    <div class="row">
      <div class="col">
        <%!-- PvE Progression --%>
        <div class="row">
          <div class="col">
            <%= if @preview do %>
              <.progression_header {assigns} />
            <% else %>
              <div class="card dark-bg mb-3" id="pve-progression">
                <div class="card-body pb-0">
                  <div class="row mt-3 mb-3 d-flex justify-content-center">
                    <%= if next = next_pve_tier(@current_player) do %>
                      <div class="col pve-tier-container text-center">
                        <img src={"/images/pve/#{@current_player.pve_tier}.png"} class="pve-rank" />
                        <h4 class="text-uppercase text-white my-0 f-rpg">
                          {Moba.pve_tiers()[@current_player.pve_tier]}
                        </h4>
                      </div>
                      <div class="col-8">
                        <h4 class="text-center mb-0 mt-0" id="base-quest-description">
                          {current_quest_description(@current_player)}
                        </h4>
                        <div
                          class="progress mt-3"
                          style="height:50px;"
                          data-toggle="tooltip"
                          title={quest_avatars_title(@current_player)}
                          role="progressbar"
                          aria-labelledby="base-quest-description"
                          aria-valuemin="0"
                          aria-valuemax="100"
                          aria-valuenow={quest_progression_pct(@current_player)}
                          aria-valuetext={quest_progression_label(@current_player)}
                        >
                          <div
                            style={"width:#{quest_progression_pct(@current_player)}%;"}
                            class="progress-bar pve-bar"
                          >
                          </div>
                          <h5
                            class="justify-content-center d-flex position-absolute w-100 text-white"
                            style="margin-top: 18px"
                          >
                            {quest_progression_label(@current_player)}
                          </h5>
                        </div>
                        <div class="mt-4 text-center">
                          <%= unless @current_player.pvp_tier == Moba.max_pvp_tier() do %>
                            <button
                              type="button"
                              class="btn btn-sm btn-light"
                              data-toggle="modal"
                              data-target="#pve-tier-rewards"
                              id="base-rewards-btn"
                            >
                              <i class="ui-icon ui-crown mr-1"></i>Progression Rewards
                            </button>
                          <% end %>
                        </div>
                      </div>
                      <div class="col pve-tier-container text-center">
                        <img src={"/images/pve/#{next}.png"} class="pve-rank" />
                        <h4 class="text-uppercase text-white my-0 f-rpg">
                          {Moba.pve_tiers()[next]}
                        </h4>
                      </div>
                    <% else %>
                      <div class="col text-center mb-2">
                        <img
                          src={"/images/pve/#{@current_player.pve_tier}.png"}
                          style="width: 150px"
                          class="user-rank"
                        />
                        <h4 class="my-0 text-uppercase text-white f-rpg">
                          {Moba.pve_tiers()[@current_player.pve_tier]}
                        </h4>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Hero List --%>
        <div class="row base-training-section">
          <div class="col">
            <div class="card">
              <div class="card-body p-0 text-center" id="hero-list-container">
                <div class="base-run-toolbar">
                  <.link
                    navigate={preview_path(assigns, training_cta_path(assigns))}
                    class={[
                      "btn p-2 btn-block btn-lg dark-button base-invoke",
                      !@preview && "btn-outline-success"
                    ]}
                    id="base-invoke-btn"
                  >
                    <.onboarding_cta_arrow :if={@guide_training_cta} />
                    <i :if={!@guide_training_cta} class="ui-icon ui-plus mr-1"></i>
                    {training_cta_label(@register_to_train)}
                  </.link>

                  <div class="base-run-controls">
                    <nav :if={@run_page > 0 || @more_runs} class="base-run-pagination" aria-label="Training run pages">
                      <button
                        id="base-runs-previous"
                        type="button"
                        class="btn btn-light"
                        phx-click="page-runs"
                        phx-value-direction="previous"
                        aria-label="Previous page"
                        disabled={@run_page == 0}
                      >
                        ←
                      </button>
                      <span aria-live="polite">{@run_page + 1}</span>
                      <button
                        id="base-runs-next"
                        type="button"
                        class="btn btn-light"
                        phx-click="page-runs"
                        phx-value-direction="next"
                        aria-label="Next page"
                        disabled={!@more_runs}
                      >
                        →
                      </button>
                    </nav>
                    <button id="base-toggle-runs" type="button" class="btn btn-light" phx-click="toggle-runs">
                      {if @filter == "unfinished", do: "Show Finished Runs", else: "Show Pending Runs"}
                    </button>
                  </div>
                </div>

                <.hero_collection :if={!@preview} {assigns} />

                <div class="w-100 hero-list darker" id={"hero-list-#{@filter}"}>
                  <.hud_notice
                    :if={@preview && @visible_heroes == [] && @visible_teams == []}
                    id="base-no-heroes"
                    title={if @filter == "finished", do: "No trained heroes yet", else: "No heroes in training"}
                  >
                    <:actions>
                      <.link navigate={preview_path(assigns, training_cta_path(assigns))} class="btn base-secondary">
                        {training_cta_label(@register_to_train)} <span aria-hidden="true">→</span>
                      </.link>
                    </:actions>
                  </.hud_notice>
                  <div class="row no-gutters base-run-grid">
                    <.team_card :for={team <- @visible_teams} team={team} />
                    <%= for hero <- @visible_heroes do %>
                      <div class="col-lg-4 col-md-6" id={"visible-hero-#{hero.id}"}>
                        <div
                          class="card hero-card mb-0"
                          style={"background-image: url(#{GH.background_url(hero)})"}
                        >
                          <div class="card-header pt-0 pb-1">
                            <h4 class="text-white d-flex justify-content-between align-items-center mb-0">
                              <span class="font-italic font-20 f-rpg hero-card-rank">
                                <%= if hero.pve_ranking do %>
                                  #{hero.pve_ranking}
                                <% end %>
                              </span>
                              <div class="hero-card-name">
                                <.league_badge tier={hero.league_tier} variant="legacy" />
                                {hero.name}
                              </div>
                              <span
                                id={"hero-level-#{hero.id}"}
                                class="font-15 font-italic hero-card-meta"
                                data-toggle="tooltip"
                                title={TT.hero_stats_tooltip(hero, true)}
                                tabindex="0"
                              >
                                Level {hero.level} {hero.avatar.name}
                              </span>
                            </h4>
                          </div>
                          <div class="card-body p-0 d-flex align-items-center justify-content-center"></div>
                          <div class="card-footer transparent p-1">
                            <div class="row">
                              <div class="col justify-content-between d-flex hero-card-controls">
                                <%= if can_delete_hero?(hero) do %>
                                  <button
                                    type="button"
                                    class="btn btn-danger hero-card-delete"
                                    title="Delete hero"
                                    data-confirm="Are you sure you want to DELETE your hero?"
                                    data-confirm-title={@preview && "Delete hero?"}
                                    data-confirm-accept={@preview && "Delete hero"}
                                    phx-click="archive"
                                    phx-value-id={hero.id}
                                  >
                                    <i class="ui-icon ui-trash mr-1"></i><span class="hero-card-delete-label">Delete</span>
                                  </button>
                                <% end %>
                                <%= if hero.finished_at do %>
                                  <.link
                                    class="btn btn-primary hero-card-customize"
                                    navigate={preview_path(assigns, ~p"/hero/#{hero}")}
                                  >
                                    <i class="ui-icon ui-id-card mr-1"></i> Customize
                                  </.link>
                                <% else %>
                                  <button
                                    type="button"
                                    class="btn btn-success hero-card-resume"
                                    phx-click="continue"
                                    phx-value-id={hero.id}
                                    data-toggle="tooltip"
                                    title={"#{hero.pve_total_turns + hero.pve_current_turns} turns left"}
                                  >
                                    <i class="ui-icon ui-sword mr-1"></i> Continue
                                  </button>
                                <% end %>
                                <div class="btn-group hero-card-metrics">
                                  <span
                                    tabindex="0"
                                    class="game-stat btn btn-icon btn-outline-light text-warning hero-card-farm"
                                    data-toggle="tooltip"
                                    title={"Total farm: #{hero.total_xp_farm + hero.total_gold_farm}. Gold farm: #{hero.total_gold_farm}. XP farm: #{hero.total_xp_farm}"}
                                  >
                                    <i class="ui-icon ui-crown"></i>
                                    <span class="hero-card-farm-value">
                                      {GH.farming_amount_label(hero.total_xp_farm + hero.total_gold_farm)}
                                    </span>
                                    <small class={["hero-card-metric-label", !@preview && "d-none"]}>
                                      Total farm
                                    </small>
                                  </span>
                                  <%= if hero.finished_at do %>
                                    <span
                                      tabindex="0"
                                      class="game-stat btn btn-icon btn-outline-light text-success hero-card-duration"
                                      data-toggle="tooltip"
                                      title="Time it took to finish Training"
                                    >
                                      <i class="ui-icon ui-clock"></i>
                                      {GH.minutes_label(GH.finished_time(hero), @preview)} min
                                    </span>
                                  <% end %>
                                </div>
                              </div>
                            </div>
                            <div class="row mt-1">
                              <div class="col-12">
                                <.hero_skill_strip
                                  skills={hero.skills}
                                  id_prefix="skill"
                                  id_suffix={hero.id}
                                />
                                <.hero_item_strip
                                  items={Moba.Game.sort_items(hero.items)}
                                  container_class="items-container row no-gutters float-right"
                                  id_prefix="item"
                                  id_suffix={hero.id}
                                />
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%= if next_pve_tier(@current_player) do %>
          <%= if @preview do %>
            <.progression_rewards tier={@current_player.pve_tier + 1} />
          <% else %>
            <%!-- PvE Tier Rewards Modal --%>
            <div
              id="pve-tier-rewards"
              class="modal fade"
              tabindex="-1"
              role="dialog"
              aria-labelledby="pve-tier-rewards-label"
            >
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h4 class="modal-title margin-auto pl-3" id="pve-tier-rewards-label">
                      Progression Rewards
                    </h4>
                    <button type="button" class="close ml-0 pl-0" data-dismiss="modal" aria-hidden="true">
                      ×
                    </button>
                  </div>
                  <div class="modal-body">
                    <div class="text-center">
                      <img src={"/images/pve/#{@current_player.pve_tier + 1}.png"} style="max-height: 70px" />
                      <br />
                      <h3>{Moba.pve_tiers()[@current_player.pve_tier + 1]}</h3>
                    </div>
                    <table class="table table-dark border margin-auto">
                      <tr>
                        <td class="text-center text-danger">
                          <i class="ui-icon ui-sword ui-2x"></i> <br /> Training Difficulty
                        </td>
                        <td class="text-left">
                          <h5>{training_difficulty_for(@current_player.pve_tier + 1)}</h5>
                        </td>
                      </tr>
                      <%= if bonus = training_bonus_for(@current_player.pve_tier + 1) do %>
                        <tr>
                          <td class="text-center text-success">
                            <i class="ui-icon ui-sword ui-2x"></i> <br /> Training Bonus
                          </td>
                          <td class="text-left">
                            <h5>{bonus}</h5>
                          </td>
                        </tr>
                      <% end %>
                      <tr>
                        <td class="text-center text-primary">
                          <i class="ui-icon ui-lotus ui-2x"></i> <br /> Farming per Turn
                        </td>
                        <td class="text-left">
                          <h5>{GH.farming_per_turn_label(@current_player.pve_tier + 1)}</h5>
                        </td>
                      </tr>
                      <tr>
                        <td class="text-center text-warning">
                          <i class="ui-icon ui-trophy ui-2x"></i> <br /> Maximum League
                        </td>
                        <td class="text-left">
                          <h4>{max_league_allowed_for(@current_player.pve_tier + 1)}</h4>
                        </td>
                      </tr>
                      <tr>
                        <td class="text-center text-info">
                          <.link
                            navigate={preview_path(assigns, ~p"/tavern")}
                            data-toggle="tooltip"
                            title="Shards are the in-game currency that you can use to unlock game content."
                          >
                            <i class="ui-icon ui-shard ui-2x"></i> <br /> Shards
                          </.link>
                        </td>
                        <td class="text-left">
                          <h4>+ {quest_shard_prize(@current_player.pve_tier + 1)}</h4>
                        </td>
                      </tr>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
