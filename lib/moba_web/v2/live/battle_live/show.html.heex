<% log_modal? = @preview && Map.get(assigns, :log_modal, false)
log_modal_open? = log_modal? && @show_combat_log %>
<div id="battle-page" phx-hook="BattleContinueHotkey" data-finished={to_string(@battle.finished)}>
  <div
    :if={@preview}
    inert={log_modal_open?}
    class={[
      "combat-stage-shell",
      !@battle.finished && Map.get(assigns, :stage_controls, []) != [] && "has-stage-automation"
    ]}
  >
    <.cinematic_stage {assigns} />
    <div :if={!@battle.finished} class="stage-automation">
      {render_slot(Map.get(assigns, :stage_controls, []))}
    </div>
  </div>
  <%= if @action_turn_number && !@preview && !@battle.finished do %>
    <div
      id="scroll-to-turn"
      phx-hook="ScrollToTarget"
      phx-target-element={"#turn-#{@action_turn_number}"}
    />
  <% end %>

  <div
    id="hero-battle"
    class={["battle mt-3", log_modal? && "arena-combat-log"]}
    hidden={@preview && !@show_combat_log}
    role={if log_modal?, do: "dialog"}
    aria-modal={if log_modal?, do: "true"}
    aria-labelledby={if log_modal?, do: "arena-combat-log-title"}
  >
    <div id="combat-log-panel" hidden={@preview && !@show_combat_log}>
      {render_slot(Map.get(assigns, :log_header, []))}
      <div :if={!@preview} class="row battle-matchup">
        <div class="col-12 col-md-5 battle-contender">
          <.hero
            preview={@preview}
            hero={GH.match_hero_loadout(@battle.attacker, [@battle])}
            last_hero={last_hero_for(@battle.attacker, @last_turn)}
            battle={@battle}
            snapshot={@snapshot}
          />
        </div>
        <div class="col-12 col-md-2 text-center versus-box">
          <h1 class="f-rpg">VS</h1>
          <%= if @battle.finished && !@preview do %>
            <p>
              <strong>Battle #{@battle.id}</strong>
              <br />
              <span class="text-dark"><em>{Timex.format!(@battle.inserted_at, "{relative}", :relative)}</em></span>
            </p>
          <% end %>
        </div>
        <div class="col-12 col-md-5 battle-contender">
          <.hero
            preview={@preview}
            hero={GH.match_hero_loadout(@battle.defender, [@battle])}
            last_hero={last_hero_for(@battle.defender, @last_turn)}
            battle={@battle}
            snapshot={@battle.defender_snapshot}
          />
        </div>
      </div>

      <div class="row">
        <div class="col-sm-12">
          <%= if length(@battle.turns) > 0 do %>
            <div class="timeline mt-3 mb-0" dir="ltr">
              <div :if={!@preview} class="text-center battle-initiated">
                <div
                  :if={!@preview}
                  class={"btn btn-lg btn-outline-#{if @battle.initiator_id == @battle.attacker_id, do: "danger", else: "primary"} width-lg"}
                  phx-hook="Scroll"
                  id="battle-initiated"
                >
                  Battle initiated by {@battle.initiator.name}
                </div>
              </div>
              <.turn
                :for={{turn, previous_turn} <- Enum.zip(@battle.turns, [@initial_turn | @battle.turns])}
                previous_turn={previous_turn}
                preview={@preview}
                turn={turn}
                is_attacker={
                  if @preview,
                    do: turn.attacker.hero_id == @battle.attacker_id,
                    else: turn.attacker.player_id == @battle.attacker_player_id
                }
                debug={@debug}
              />
              <div class="clearfix"></div>
              <%= if @battle.finished && !@preview do %>
                <.battle_over_action battle={@battle} />
                <.share_battle_action battle={@battle} />
              <% end %>
            </div>
          <% else %>
            <%= if !@preview do %>
              <%= if active_attacker?(@battle, @last_turn, @current_player) do %>
                <div class="text-center mt-5 battle-empty" id="battle-ready">
                  <h3 class="mt-5">
                    Click to select a skill on the battle bar below and then click the Attack button to start the battle!
                  </h3>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="clearfix">&nbsp;</div>
    </div>
  </div>

  <div
    id="battle-bar"
    inert={log_modal_open?}
    style={@preview && "--result-scene: url(/images/tutorial/arena-of-ascension.jpg)"}
  >
    <div class="container-fluid">
      <div class="row">
        <.turn_hero
          :if={!@preview}
          preview={@preview}
          battle={@battle}
          turn={@turn}
          hero={@battle.attacker}
          turn_hero={
            if(@turn.attacker.player_id == @battle.attacker_player_id, do: @turn.attacker, else: @turn.defender)
          }
        />

        <div
          id={Map.get(assigns, :action_controls_id)}
          class="col-12 col-xl-8 battle-border-left battle-border-right battle-command"
        >
          <%= if @battle.finished do %>
            <%= if Map.get(assigns, :result, []) != [] do %>
              {render_slot(@result)}
            <% else %>
              <%= case @battle.type do %>
                <% "pve" -> %>
                  <.pve_rewards
                    preview={Map.get(assigns, :preview, false)}
                    battle={@battle}
                    snapshot={@snapshot}
                    current_player={@current_player}
                  />
                <% "league" -> %>
                  <.league_rewards
                    preview={Map.get(assigns, :preview, false)}
                    battle={@battle}
                    snapshot={@snapshot}
                    current_player={@current_player}
                  />
                <% "duel" -> %>
                  <.duel_rewards
                    preview={Map.get(assigns, :preview, false)}
                    battle={@battle}
                    current_player={@current_player}
                  />
                <% "match" -> %>
                  <.match_rewards
                    preview={Map.get(assigns, :preview, false)}
                    battle={@battle}
                    current_player={@current_player}
                  />
                <% _ -> %>
                  <div></div>
              <% end %>
            <% end %>
          <% else %>
            <%= if Map.get(assigns, :actions, []) != [] do %>
              {render_slot(@actions)}
            <% else %>
              <.active_battle
                preview={@preview}
                battle={@battle}
                last_turn={@last_turn}
                current_player={@current_player}
                turn={@turn}
                skill={@skill}
                turn_timer={@turn_timer}
                active_hero_id={
                  Map.get_lazy(assigns, :active_hero_id, fn ->
                    cond do
                      active_attacker?(@battle, @last_turn, @current_player) -> @battle.attacker_id
                      active_defender?(@battle, @last_turn, @current_player) -> @battle.defender_id
                      true -> nil
                    end
                  end)
                }
              />
            <% end %>
          <% end %>
        </div>

        <.turn_hero
          :if={!@preview}
          preview={@preview}
          battle={@battle}
          turn={@turn}
          hero={@battle.defender}
          turn_hero={
            if(@turn.attacker.player_id == @battle.attacker_player_id, do: @turn.defender, else: @turn.attacker)
          }
        />
      </div>
      <%= unless @battle.finished do %>
        {render_slot(Map.get(assigns, :footer, []))}
      <% end %>
    </div>
  </div>
  <div
    :if={@battle.finished && Map.get(assigns, :footer, []) != []}
    class="battle-lineup-footer"
    inert={log_modal_open?}
  >
    {render_slot(@footer)}
  </div>
</div>
