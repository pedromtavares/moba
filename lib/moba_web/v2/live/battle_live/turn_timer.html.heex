<%= if show_timer?(assigns) do %>
  <span
    tabindex="0"
    class={if @preview, do: "battle-turn-clock", else: "game-stat btn btn-outline-warning ml-2 no-action"}
    data-toggle="tooltip"
    title="Seconds left to act"
  >
    <i class="fa fa-hourglass mr-1"></i><span
      phx-hook="TurnTimer"
      data-timer={if @preview, do: max(@turn_timer, 0), else: @turn_timer}
      data-hero={@hero.id}
      id="turn-timer"
    >{if @preview, do: max(@turn_timer, 0), else: @turn_timer}</span>
  </span>
<% end %>
