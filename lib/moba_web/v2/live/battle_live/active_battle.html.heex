<div class="row battle-actions">
  <div class={[
    "col col-md-6 battle-action-side",
    @preview && @active_hero_id != @battle.attacker_id && "battle-passive-side"
  ]}>
    <%= if @active_hero_id == @battle.attacker_id do %>
      <.active_turn
        preview={@preview}
        battle={@battle}
        last_turn={@last_turn}
        current_player={@current_player}
        turn={@turn}
        skill={@skill}
        turn_timer={@turn_timer}
        hero={GH.match_hero_loadout(@battle.attacker, [@battle])}
      />
    <% else %>
      <.passive_turn
        preview={@preview}
        battle={@battle}
        last_turn={@last_turn}
        current_player={@current_player}
        turn={@turn}
        skill={@skill}
        turn_timer={@turn_timer}
        hero={GH.match_hero_loadout(@battle.attacker, [@battle])}
      />
    <% end %>
  </div>
  <div class={[
    "col-6 battle-border-left battle-action-side",
    if(@preview,
      do: @active_hero_id != @battle.defender_id && "battle-passive-side",
      else: "d-none d-md-block"
    )
  ]}>
    <%= if @active_hero_id == @battle.defender_id do %>
      <.active_turn
        preview={@preview}
        battle={@battle}
        last_turn={@last_turn}
        current_player={@current_player}
        turn={@turn}
        skill={@skill}
        turn_timer={@turn_timer}
        hero={GH.match_hero_loadout(@battle.defender, [@battle])}
      />
    <% else %>
      <.passive_turn
        preview={@preview}
        battle={@battle}
        last_turn={@last_turn}
        current_player={@current_player}
        turn={@turn}
        skill={@skill}
        turn_timer={@turn_timer}
        hero={GH.match_hero_loadout(@battle.defender, [@battle])}
      />
    <% end %>
  </div>
</div>
