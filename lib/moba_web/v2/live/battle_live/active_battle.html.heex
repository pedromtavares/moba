<div class="row battle-actions">
  <div class={[
    "col col-md-6 battle-action-side",
    @preview && !active_attacker?(@battle, @last_turn, @current_player) && "battle-passive-side"
  ]}>
    <%= if active_attacker?(@battle, @last_turn, @current_player) do %>
      <.active_turn
        preview={@preview}
        battle={@battle}
        last_turn={@last_turn}
        current_player={@current_player}
        turn={@turn}
        skill={@skill}
        turn_timer={@turn_timer}
        hero={@battle.attacker}
      />
    <% else %>
      <.passive_turn
        preview={@preview}
        battle={@battle}
        last_turn={@last_turn}
        current_player={@current_player}
        turn={@turn}
        skill={@skill}
        turn_timer={@turn_timer}
        hero={@battle.attacker}
      />
    <% end %>
  </div>
  <div class={[
    "col-6 battle-border-left battle-action-side",
    if(@preview,
      do: !active_defender?(@battle, @last_turn, @current_player) && "battle-passive-side",
      else: "d-none d-md-block"
    )
  ]}>
    <%= if active_defender?(@battle, @last_turn, @current_player) do %>
      <.active_turn
        preview={@preview}
        battle={@battle}
        last_turn={@last_turn}
        current_player={@current_player}
        turn={@turn}
        skill={@skill}
        turn_timer={@turn_timer}
        hero={@battle.defender}
      />
    <% else %>
      <.passive_turn
        preview={@preview}
        battle={@battle}
        last_turn={@last_turn}
        current_player={@current_player}
        turn={@turn}
        skill={@skill}
        turn_timer={@turn_timer}
        hero={@battle.defender}
      />
    <% end %>
  </div>
</div>
