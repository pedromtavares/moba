<section
  class="battle-active-turn"
  aria-label={"Choose an action for #{@hero.name}"}
  aria-busy={to_string(Map.get(assigns, :controls_disabled, false))}
  inert={Map.get(assigns, :controls_disabled, false)}
>
  <div class="row mt-2 action-submit">
    <div class="col center">
      <button
        class="btn btn-danger attack-button"
        phx-hook="AttackButton"
        id="attack-button"
        aria-keyshortcuts="Space"
        data-skill={@skill && @skill.id}
        data-hero={@hero.id}
        disabled={Map.get(assigns, :controls_disabled, false)}
      >
        <span class="loading-text">
          <%= if Map.get(assigns, :controls_disabled, false) do %>
            Resolving…
          <% else %>
            Attack with
          <% end %>
          <span id="active-skill-name" hidden={Map.get(assigns, :controls_disabled, false)}>{skill_name(@skill)}</span>
          <span id="active-item-name"></span>
          <kbd class="attack-hotkey" aria-hidden="true">SPACE</kbd>
        </span>
      </button>
      <.turn_timer preview={@preview} battle={@battle} last_turn={@last_turn} hero={@hero} turn_timer={@turn_timer} />
    </div>
  </div>
  <div class="row mb-1 mt-1 battle-skills-row">
    <div class="col">
      <div class="skills-container" aria-label="Skills">
        <%= for {skill, index} <- Enum.with_index(@hero.skills) do %>
          <%= cond do %>
            <% skill.code == "pulse_nova" && @turn.attacker.pulse_nova -> %>
              <div id="pulse-nova-running" class="img-container skill-container float-left pulse-nova-running">
                <.battle_resource_image
                  resource={skill}
                  data-index={index}
                  class="skill-img"
                  id={"running-skill-#{skill.id}"}
                />
                <span class="badge badge-pill badge-primary mp-cost pulse-nova-status">
                  {if Moba.Engine.Core.BuffPause.paused?(@turn.attacker), do: "PAUSED", else: "ON · #{skill.mp_cost}"}
                </span>
              </div>
            <% can_use?(@turn, skill) && !@turn.attacker.double_skill -> %>
              <div class="img-container skill-container float-left" data-resource={skill.id}>
                <.battle_resource_image
                  resource={skill}
                  phx-value-id={skill.id}
                  data-index={index}
                  data-name={skill.name}
                  class={"skill-img can-use #{if @skill && @skill.code == skill.code, do: "current-skill"}"}
                  role={@preview && "button"}
                  tabindex={@preview && "0"}
                  aria-label={@preview && "Select #{skill.name}"}
                  aria-pressed={@preview && to_string((@skill && @skill.code == skill.code) || false)}
                  phx-hook="InstaSkill"
                  id={"active-skill-#{skill.id}"}
                />
                <span class="badge badge-pill badge-primary mp-cost">{skill.mp_cost}</span>
                <span class="hotkey f-rpg">{skill_hotkey(index)}</span>
              </div>
            <% true -> %>
              <div class="img-container skill-container float-left inactive">
                <.battle_resource_image
                  resource={skill}
                  data-index={index}
                  class="skill-img"
                  id={"inactive-skill-#{skill.id}"}
                />
                <.resource_status_badge preview={@preview} resource={skill} battler={@turn.attacker} />
              </div>
          <% end %>
        <% end %>
        <div
          class={"img-container basic-attack float-left #{@turn.attacker.double_skill && "inactive"}"}
          data-resource=""
        >
          <img
            phx-click="pick-skill"
            phx-value-id=""
            data-index="4"
            src="/images/basic_attack.png"
            data-toggle="tooltip"
            title={TT.basic_attack_tooltip()}
            data-name="Basic Attack"
            class={"skill-img can-use #{unless @skill, do: "current-skill"}"}
            data-resource=""
            phx-hook="InstaSkill"
            role={@preview && "button"}
            tabindex={@preview && "0"}
            aria-label={@preview && "Select Basic Attack"}
            aria-pressed={@preview && to_string(!@skill)}
            id="pick-basic-attack"
          />
          <span class="hotkey f-rpg">{skill_hotkey(4)}</span>
        </div>
      </div>
    </div>
  </div>
  <div class="row battle-items-row">
    <div class="col">
      <div class="items-container" aria-label="Items">
        <% slots = Game.Items.item_slots(@hero) %>
        <.battle_item_control
          :for={{item, index} <- Enum.with_index(slots)}
          item={item}
          index={index}
          turn={@turn}
          preview={@preview}
        />
        <%= if length(slots) < 6 do %>
          <%= for _ <- (length(slots)..5) do %>
            <div class="img-container item-container float-left">
              <.empty_item_slot />
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>
