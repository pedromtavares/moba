<div class="hero-card card" style={"background-image: url(#{GH.background_url(@hero)})"}>
  <div class="card-header pt-0 pb-1">
    <h4 class="font-17 text-white d-flex justify-content-between align-items-center mb-0">
      <span class="font-italic level font-15">Level {(@last_hero && @last_hero.level) || @hero.level}</span>
      <div>
        <.league_badge
          tier={@snapshot && @snapshot.league_tier || @hero.league_tier}
          variant="legacy"
          img_class="mr-1"
        />
        <span class="font-17">{@hero.name}</span>
      </div>
      <%= if @battle.type == "pve" && @hero.bot_difficulty do %>
        <span class={"font-15 font-italic text-#{difficulty_color(@hero.bot_difficulty)}"}>
          {difficulty_label(@hero.bot_difficulty)}
        </span>
      <% else %>
        <span class="font-15 font-italic">{@hero.avatar.name}</span>
      <% end %>
    </h4>
  </div>
  <div class="card-body text-center"></div>
  <div class="transparent card-footer p-0 text-center">
    <div class="row align-items-center d-flex ml-1 mt-1 mr-1">
      <div class="col">
        <.battle_hero_stat_group
          hp={total_hp_for(@hero, @last_hero)}
          mp={total_mp_for(@hero, @last_hero)}
          atk={total_atk_for(@hero, @last_hero)}
          power={total_power_for(@hero, @last_hero)}
          armor={total_armor_for(@hero, @last_hero)}
          speed={total_speed_for(@hero, @last_hero)}
        />
      </div>
    </div>
    <div class="row">
      <div class="col-12 mt-1">
        <.hero_skill_strip
          skills={@hero.skills}
          container_class={"skills-container d-flex justify-content-between #{if length(@hero.items) == 0, do: "float-none margin-auto"}"}
          id_prefix="skill"
          id_suffix={@hero.id}
        />
        <%= if length(@hero.items) > 0 do %>
          <.hero_item_strip items={Game.sort_items(@hero.items)} id_prefix="item" id_suffix={@hero.id} />
        <% end %>
      </div>
    </div>
  </div>
</div>
