<div :if={@roster != []} id={GH.dom_id(@id_prefix, "hero-team-tabs")} class="hud-team-roster">
  {render_slot(@roster)}
</div>
<div
  id={GH.dom_id(@id_prefix, "hero-bar")}
  class={["hero-bar", (@roster != [] || @team_roster) && "has-team-roster"]}
  phx-hook="ShopViewport"
>
  <div class="container-fluid">
    <.form
      for={@orders_form}
      id={GH.dom_id(@id_prefix, "hero-loadout-form")}
      phx-submit="finalize-edit"
      {target_attrs(@event_target, @hero_id)}
    >
      <div class="row hero-hud-row">
        <div class="hud-identity d-none d-md-block col-3 col-md-2 col-lg-2 col-xl-2 center">
          <%= if @identity != [] do %>
            {render_slot(@identity)}
          <% else %>
            <div class="row mt-2">
              <div
                class="col"
                data-toggle="tooltip"
                data-tooltip-artwork={@preview && !@resource_tooltip && "hero"}
                tabindex={@preview && "0"}
                title={@resource_tooltip || "<img src='#{GH.background_url(@current_hero)}' style='max-width:500px'/>"}
              >
                <div class="avatar-container">
                  <img src={GH.image_url(@current_hero.avatar)} class="avatar img-border" />
                </div>
              </div>
            </div>
            <h3 class="mb-0 mt-1 hero-name" phx-click="level" {target_attrs(@event_target, @hero_id)}>
              {@display_name || @current_hero.name}
            </h3>
          <% end %>
        </div>
        <div class={"hud-progress col col-md-5 col-lg-5 col-xl-4 #{if @show_build, do: "d-none"}"}>
          <div class="flex-column">
            {render_slot(@resources)}
            <div class="row  d-none d-md-block">
              <div class="col">
                <%= if @preview do %>
                  <.hud_experience hero={@current_hero} max_level={@max_level} />
                <% else %>
                  <div
                    class="progress progress-fixed xp-bar"
                    data-toggle="tooltip"
                    title={"Experience: #{@current_hero.experience}/#{xp_to_next_level(@current_hero)}"}
                  >
                    <div style={"width:#{xp_percentage(@current_hero)}%"} class="progress-bar bg-white">
                      <span class="font-15 f-rpg">Level {@current_hero.level}</span>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
            <div
              class="row d-none d-md-block no-gutters hud-current-stats"
              id={GH.dom_id(@id_prefix, "current-hero-stats")}
            >
              <div class="col flex no-wrap pl-0" style="overflow: visible;">
                <.hero_bar_stats current_hero={@current_hero} />
              </div>
            </div>
          </div>
        </div>
        <div class={"hud-build col-lg-5 col-xl-4 d-none d-md-block col-md-4 #{if @show_build, do: "d-block"}"}>
          {render_slot(@skill_guidance)}
          <div class="row">
            <div class="col center">
              <div class={"skills-container #{if @editing, do: "editing"}"}>
                <%= for {skill, index} <- Enum.with_index(sorted_skills(@current_hero)) do %>
                  <div
                    class={"skill-container #{if skill.passive, do: "passive", else: "active"}"}
                    data-hud-skill-index={index}
                  >
                    <%= if can_level_skill?(@current_hero, skill) do %>
                      <a
                        href="javascript:;"
                        class="hud-upgrade"
                        aria-label={"Level up #{skill.name} to rank #{skill.level + 1}"}
                        phx-click="skill"
                        phx-value-code={skill.code}
                        aria-keyshortcuts={@preview && Enum.at(~w(Q W E R), index)}
                        {target_attrs(@event_target, @hero_id)}
                      >
                        <img
                          src={GH.image_url(skill)}
                          data-toggle="tooltip"
                          title={next_skill_description(skill)}
                          class={"skill-img can-level img-border #{if skill.passive, do: "passive"} #{if skill.ultimate, do: "ultimate"}"}
                        />
                        <span :if={@preview} class="hud-upgrade-plus" aria-hidden="true">+</span>
                        <kbd :if={@preview} class="hud-skill-hotkey" aria-hidden="true">
                          {Enum.at(~w(Q W E R), index)}
                        </kbd>
                      </a>
                    <% else %>
                      <img
                        src={GH.image_url(skill)}
                        data-toggle="tooltip"
                        title={TT.skill_tooltip(skill)}
                        class={"skill-img img-border tooltip-mobile #{if skill.passive, do: "passive"} #{if skill.ultimate, do: "ultimate"}"}
                      />
                    <% end %>
                    <%= if @editing do %>
                      <%= if !skill.passive do %>
                        <div class="form-group">
                          <select class="custom-select" name={"skill_order[#{skill.code}]"}>
                            <%= for {code, index} <- Enum.with_index(@current_hero.skill_order, 1) do %>
                              <option value={index} selected={if code == skill.code, do: "selected"}>{index}</option>
                            <% end %>
                          </select>
                        </div>
                      <% end %>
                    <% else %>
                      <div
                        class="skill-levels"
                        aria-label={"#{skill.name} rank #{skill.level} of #{max_skill_level(skill)}"}
                      >
                        <%= for _ <- (1..skill.level) do %>
                          <i class="ui-icon ui-circle text-warning"></i>
                        <% end %>
                        <%= if skill.level < max_skill_level(skill) do %>
                          <%= for _ <- ((skill.level + 1)..max_skill_level(skill)) do %>
                            <i class="ui-icon ui-circle"></i>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          <div class="row mt-1 hud-build-actions">
            <div class="col center">
              <%= if @current_hero.skill_levels_available > 0 do %>
                <%= if @preview do %>
                  <div
                    id={GH.dom_id(@id_prefix, "hud-skill-points")}
                    class="hud-skill-points"
                    role="status"
                  >
                    <strong>+{@current_hero.skill_levels_available}</strong>
                    <span>Skill point{if @current_hero.skill_levels_available > 1, do: "s"} available</span>
                  </div>
                <% else %>
                  <em class="text-warning">
                    You have {@current_hero.skill_levels_available} available skill point{if @current_hero.skill_levels_available >
                                                                                               1,
                                                                                             do: "s"}, click on a skill to level it up!
                  </em>
                <% end %>
              <% else %>
                <%= if @editing do %>
                  <button
                    type="submit"
                    id={GH.dom_id(@id_prefix, "save-button")}
                    class="btn btn-sm btn-warning mt-2"
                  >
                    Save
                  </button>
                  <button
                    :if={@preview}
                    type="button"
                    id={GH.dom_id(@id_prefix, "cancel-orders-button")}
                    class="btn btn-sm btn-outline-light mt-2 ml-2"
                    phx-click="cancel-edit"
                    {target_attrs(@event_target, @hero_id)}
                  >
                    Cancel
                  </button>
                <% else %>
                  <a
                    href="javascript:;"
                    id={GH.dom_id(@id_prefix, "edit-button")}
                    phx-click="start-edit"
                    data-toggle="tooltip"
                    title={edit_orders_label(@current_hero)}
                    class="badge badge-pill badge-light-warning py-1 px-2 font-13 d-none d-md-inline"
                    {target_attrs(@event_target, @hero_id)}
                  >
                    <i class="ui-icon ui-edit mr-1"></i>Edit Orders
                  </a>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
        <div
          class={["hud-inventory col-lg-2 d-none d-xl-block", @show_build && "hud-inventory-open"]}
          id={GH.dom_id(@id_prefix, "current-hero-gold")}
        >
          <div class="row">
            <div class="col center">
              <h3 class="mb-1 mt-0 no-wrap">
                <span class="text-warning mr-1"><i class="ui-icon ui-coins"></i> {@current_hero.gold}</span>
                <a
                  href="javascript:;"
                  id={GH.dom_id(@id_prefix, "toggle-shop")}
                  aria-keyshortcuts={@preview && "F"}
                  class={"badge badge-light-warning border border-warning toggle-shop #{if @show_shop, do: "active-shop"}"}
                  phx-click="toggle-shop"
                  phx-hook="ToggleShop"
                  {target_attrs(@event_target, @hero_id)}
                >
                  SHOP<kbd :if={@preview} class="hud-skill-hotkey hud-shop-hotkey" aria-hidden="true">F</kbd>
                </a>
                {render_slot(@shop_actions)}
              </h3>
              <div
                class={"inventory hud-inventory-items #{if @editing, do: "editing"}"}
                id={GH.dom_id(@id_prefix, "hero-inventory")}
                phx-hook="InventoryOrder"
                data-hero-id={@current_hero.id}
                data-reorderable={to_string(@reorderable && !@editing)}
                data-inventory-order="true"
                data-order-status={GH.dom_id(@id_prefix, "hero-inventory-status")}
                role="group"
                aria-label="Hero inventory"
              >
                <%= for item <- sorted_items(@current_hero) do %>
                  <div
                    class={"item-container #{if !item.active, do: "passive", else: "active"}"}
                    id={GH.dom_id(@id_prefix, "inventory-#{item.id}")}
                    data-item-code={item.code}
                    data-item-name={item.name}
                    data-rarity={item.rarity}
                    phx-click={!@editing && "open-shop-item"}
                    phx-value-code={item.code}
                    {target_attrs(@event_target, @hero_id)}
                    role={@reorderable && "button"}
                    tabindex={if @reorderable, do: "0"}
                    aria-label={if @reorderable, do: "#{item.name}. Drag to reorder, or use Alt and arrow keys."}
                    aria-keyshortcuts={if @reorderable, do: "Alt+ArrowLeft Alt+ArrowRight Alt+ArrowUp Alt+ArrowDown"}
                    data-toggle="tooltip"
                    title={TT.item_tooltip(item)}
                  >
                    <img
                      src={GH.image_url(item)}
                      class="item-img img-border-sm"
                      alt=""
                      draggable="false"
                    />
                    <%= if @editing do %>
                      <%= if item.active do %>
                        <div class="form-group">
                          <select class="custom-select" name={"item_order[#{item.code}]"}>
                            <%= for {code, index} <- Enum.with_index(@current_hero.item_order, 1) do %>
                              <option value={index} selected={if code == item.code, do: "selected"}>{index}</option>
                            <% end %>
                          </select>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>

                <%= if length(@current_hero.items) < 6 do %>
                  <%= for _ <- (length(@current_hero.items)..5) do %>
                    <div class="item-container float-left">
                      <div class="item-img empty-item d-flex justify-content-center align-items-center">
                        <i class="ui-icon ui-cube ui-2x"></i>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
              <span
                id={GH.dom_id(@id_prefix, "hero-inventory-status")}
                class="sr-only"
                role="status"
                aria-live="polite"
                phx-update="ignore"
              >
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="row d-flex d-md-none mobile-row no-gutters">
        <%= if @show_build do %>
          <div class="col-12 tiny-stats mb-1 text-center mt-1">
            <.hero_bar_stats current_hero={@current_hero} />
          </div>
        <% else %>
          <div class="col-5 pr-0">
            <%= if @preview do %>
              <.hud_experience hero={@current_hero} compact={true} max_level={@max_level} />
            <% else %>
              <div
                class="progress progress-fixed xp-bar border border-white tooltip-mobile"
                data-toggle="tooltip"
                title={"Experience: #{@current_hero.experience}/#{xp_to_next_level(@current_hero)}"}
                style="margin-top:0.3rem"
              >
                <div style={"width:#{xp_percentage(@current_hero)}%"} class="progress-bar bg-white">
                  <span>{@current_hero.level}</span>
                </div>
              </div>
            <% end %>
          </div>
          <div class="col-7">
            <h3 class="mb-1 mt-0 pt-1 text-right" id={GH.dom_id(@id_prefix, "tiny-shop")}>
              <span class="text-warning mr-1"><i class="ui-icon ui-coins"></i> {@current_hero.gold}</span>
              <a
                href="javascript:;"
                phx-click="toggle-shop"
                id={GH.dom_id(@id_prefix, "toggle-tiny-shop")}
                phx-hook="ToggleShop"
                class={"badge badge-light-warning border border-warning toggle-shop #{if @show_shop, do: "active-shop"}"}
                {target_attrs(@event_target, @hero_id)}
              >
                SHOP<kbd :if={@preview} class="hud-skill-hotkey hud-shop-hotkey" aria-hidden="true">F</kbd>
              </a>
            </h3>
          </div>
        <% end %>
        <div :if={@mobile_shop_actions != []} class="col-12 mobile-shop-actions">
          {render_slot(@mobile_shop_actions)}
        </div>
        <div class="col-12 mobile-nav-buttons">
          <%= if @show_build do %>
            <button
              type="button"
              class="btn btn-block btn-outline-info text-primary rounded-0"
              phx-click="show-navigation"
              {target_attrs(@event_target, @hero_id)}
            >
              <i class="ui-icon ui-circle-arrow-left mr-1"></i>Show Navigation
            </button>
          <% else %>
            <%= if @current_hero.skill_levels_available > 0 do %>
              <button
                type="button"
                class="btn btn-block btn-outline-warning text-warning can-level rounded-0"
                phx-click="show-build"
                {target_attrs(@event_target, @hero_id)}
              >
                You have an available skill point!<i class="ui-icon ui-circle-arrow-right ml-1"></i>
              </button>
            <% else %>
              <button
                type="button"
                class="btn btn-block btn-outline-info text-primary rounded-0 btn-xs"
                phx-click="show-build"
                {target_attrs(@event_target, @hero_id)}
              >
                Show Build<i class="ui-icon ui-circle-arrow-right ml-1"></i>
              </button>
            <% end %>
          <% end %>
        </div>
      </div>
    </.form>
  </div>
  <h3 class="mb-1 mt-0 d-none d-md-block d-xl-none hud-small-shop" id={GH.dom_id(@id_prefix, "small-shop")}>
    <span class="text-warning mr-1"><i class="ui-icon ui-coins"></i> {@current_hero.gold}</span>
    <a
      href="javascript:;"
      id={GH.dom_id(@id_prefix, "toggle-small-shop")}
      aria-keyshortcuts={@preview && "F"}
      phx-click="toggle-shop"
      phx-hook="ToggleShop"
      class={"badge badge-light-warning border border-warning toggle-shop #{if @show_shop, do: "active-shop"}"}
      {target_attrs(@event_target, @hero_id)}
    >
      SHOP<kbd :if={@preview} class="hud-skill-hotkey hud-shop-hotkey" aria-hidden="true">F</kbd>
    </a>
  </h3>

  <div
    class={"shop-modal #{if @show_shop, do: "d-block", else: "d-none"}"}
    phx-hook="ShopKeyboard"
    {target_attrs(@event_target, @hero_id)}
    id={GH.dom_id(@id_prefix, "shop-modal")}
    role="dialog"
    aria-modal="true"
    aria-labelledby={GH.dom_id(@id_prefix, "shop-title")}
  >
    <.live_component
      module={ShopComponent}
      id_prefix={@id_prefix}
      hero_id={@hero_id}
      current_hero={@current_hero}
      event_target={@event_target}
      reorderable={@reorderable && !@editing}
      id={GH.dom_id(@id_prefix, "shop")}
    />
  </div>
</div>
