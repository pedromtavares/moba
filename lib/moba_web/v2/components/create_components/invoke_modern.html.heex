<section
  id="invoke-modern"
  class="invoke-modern"
  phx-hook="InvokeStage"
  phx-update="ignore"
  data-creation={invoke_creation_data(assigns)}
  data-role={@selected_avatar.role}
  data-mode={if @custom, do: "custom", else: "presets"}
  aria-label={"Choose your hero · #{@selected_avatar.name}"}
>
  <div
    id="invoke-art-stage"
    class="invoke-art-stage"
    data-art-url={GH.background_url(@selected_avatar)}
    aria-hidden="true"
  >
    <img class="invoke-art-layer is-active" src={GH.background_url(@selected_avatar)} alt="" />
    <img class="invoke-art-layer" alt="" />
  </div>
  <div class="invoke-atmosphere" aria-hidden="true"></div>
  <div class="invoke-stage-content">
    <div class="invoke-identity" id={"avatar-#{@selected_avatar.id}"} data-invoke-identity>
      <nav :if={@current_player.user_id} id="training-mode" class="training-mode" aria-label="Training mode">
        <.link navigate="/new" aria-current={Map.get(assigns, :draft_mode, false) && "page"}>Team 3v3</.link>
        <.link navigate="/new/solo" aria-current={!Map.get(assigns, :draft_mode, false) && "page"}>Solo 1v1</.link>
      </nav>
      <div class="invoke-role">
        <img src={"/images/#{@selected_avatar.role}_icon.png"} alt="" />
        <span data-invoke-role>{role(@selected_avatar)}</span>
      </div>
      <h1 id="invoke-hero-name">{@selected_avatar.name}</h1>
      <p class="invoke-gameplay" data-invoke-description>{@selected_avatar.description}</p>
      <div
        class="invoke-signature"
        tabindex="0"
        data-toggle="tooltip"
        title={TT.skill_tooltip(@selected_avatar.ultimate)}
      >
        <img src={GH.image_url(@selected_avatar.ultimate)} alt="" />
        <div><small>Ultimate</small><strong>{@selected_avatar.ultimate.name}</strong></div>
      </div>
      <div class="invoke-details" id={"invoke-details-#{@selected_avatar.id}"}>
        <.invoke_stats avatar={@selected_avatar} avatars={@all_avatars} />
      </div>
      <.link :if={is_nil(@current_player.user_id)} href="/users/log_in" id="invoke-guest-sign-in">
        <i class="ui-icon ui-sign-in" aria-hidden="true"></i>
        <span>Already registered? <strong>Sign in</strong></span>
      </.link>
    </div>

    <aside class="invoke-build-panel" aria-label="Hero build">
      <header class="invoke-section-heading">
        <div>
          <h2>{if @custom, do: "Choose 3 skills", else: "Choose your build"}</h2>
        </div>
        <button
          hidden={@custom}
          class="invoke-secondary"
          type="button"
          data-invoke-action="mode"
          id="custom-build-button"
        >
          Custom →
        </button>
        <button
          hidden={!@custom}
          class="invoke-secondary"
          type="button"
          data-invoke-action="mode"
          id="back-to-builds-button"
        >
          ← Presets
        </button>
      </header>
      <div class="invoke-custom-grid" id="invoke-custom-skills" hidden={!@custom}>
        <button
          :for={skill <- @skills}
          type="button"
          id={"pick-skill-#{skill.id}"}
          class="invoke-skill-choice"
          data-invoke-action="skill"
          data-skill-id={skill.id}
          aria-pressed={to_string(Enum.member?(@selected_skills, skill))}
          aria-disabled={to_string(length(@selected_skills) == 3 && !Enum.member?(@selected_skills, skill))}
        >
          <span class="invoke-skill-image" data-toggle="tooltip" title={TT.skill_tooltip(skill)}>
            <img src={GH.image_url(skill)} alt="" />
            <span hidden={!Enum.member?(@selected_skills, skill)} class="invoke-check" aria-hidden="true">✓</span>
            <span :if={skill.passive} class="invoke-passive-dot" title="Passive" aria-label="Passive">◆</span>
          </span>
          <strong>{skill.name}</strong>
          <.invoke_energy skill={skill} />
        </button>
      </div>
      <div class="invoke-builds" id="invoke-builds" hidden={@custom}>
        <article
          :for={{build, index} <- Enum.with_index(builds_for(@selected_avatar.role))}
          class="invoke-build"
          id={"invoke-build-#{index}"}
          data-selected={to_string(@selected_build_index == index)}
          style={"--invoke-build-art: url(#{invoke_build_art(elem(build, 1))})"}
        >
          <button
            type="button"
            id={"pick-build-#{index}"}
            data-invoke-action="build"
            data-build-index={index}
            aria-pressed={to_string(@selected_build_index == index)}
            class="invoke-build-pick"
          >
            <span class="invoke-build-number">0{index + 1}</span>
            <strong>{elem(build, 1)}</strong>
            <span class="invoke-build-mark" aria-hidden="true">
              {if @selected_build_index == index, do: "✓", else: "＋"}
            </span>
          </button>
          <div class="invoke-build-skills">
            <img
              :for={skill <- elem(build, 0)}
              src={GH.image_url(skill)}
              alt={skill.name}
              tabindex="0"
              data-toggle="tooltip"
              title={TT.skill_tooltip(skill)}
              id={"skill_build_#{skill.id}_#{index}"}
            />
          </div>
        </article>
      </div>
      <div id="invoke-build-footer" class="invoke-build-footer">
        <section id="create-bar" class="invoke-loadout" aria-label="Selected skill build">
          <header>
            <h3>{build_title(@selected_avatar, @selected_skills, @selected_build_index)}</h3>
          </header>
          <div class="invoke-loadout-skills">
            <div :for={skill <- @selected_skills} class="invoke-loadout-slot">
              <button
                :if={@custom}
                type="button"
                data-invoke-action="skill"
                data-skill-id={skill.id}
                id={"skill_#{skill.id}"}
                aria-label={"Remove #{skill.name}"}
              >
                <img src={GH.image_url(skill)} alt={skill.name} data-toggle="tooltip" title={TT.skill_tooltip(skill)} />
                <span class="invoke-remove" aria-hidden="true">×</span>
              </button>
              <img
                :if={!@custom}
                src={GH.image_url(skill)}
                alt={skill.name}
                id={"skill_#{skill.id}"}
                tabindex="0"
                data-toggle="tooltip"
                title={TT.skill_tooltip(skill)}
              />
              <strong>{skill.name}</strong>
              <.invoke_energy skill={skill} />
            </div>
            <div :for={_ <- List.duplicate(nil, max(3 - length(@selected_skills), 0))} class="invoke-loadout-slot">
              <span class="invoke-empty" aria-label="Empty skill slot">＋</span><span class="invoke-empty-label">Choose a skill</span>
            </div>
            <div class="invoke-loadout-slot invoke-ultimate-slot">
              <img
                src={GH.image_url(@selected_avatar.ultimate)}
                alt={@selected_avatar.ultimate.name}
                id={"skill_#{@selected_avatar.ultimate.id}"}
                tabindex="0"
                data-toggle="tooltip"
                title={TT.skill_tooltip(@selected_avatar.ultimate)}
              />
              <strong>{@selected_avatar.ultimate.name}</strong>
              <span class="invoke-ultimate-meta">
                <small>Ultimate</small> <.invoke_energy skill={@selected_avatar.ultimate} />
              </span>
            </div>
          </div>
        </section>

        <div class="invoke-launch">
          <%= if Map.get(assigns, :draft_mode, false) || (@current_player && Map.get(@current_player, :id)) do %>
            <.invoke_name
              :if={@current_player.user_id && !Map.get(assigns, :draft_mode, false)}
              name={@name}
              error={@error}
            />
            <button
              type="button"
              id="create-button"
              class="invoke-primary"
              data-hero-name={@selected_avatar.name}
              data-hero-art={GH.background_url(@selected_avatar)}
              data-invoke-action="create"
              disabled={length(@selected_skills) != 3 || (!Map.get(assigns, :draft_mode, false) && !is_nil(@error))}
            >
              <span class="invoke-launch-label">
                <.icon
                  name={if Map.get(assigns, :draft_mode, false), do: "game-team", else: "nav-training"}
                  class="invoke-launch-icon"
                />
                <span>{Map.get(assigns, :launch_label, "Begin training")}</span>
              </span>
              <span aria-hidden="true">→</span>
            </button>
          <% else %>
            <.form for={to_form(%{})} id="invoke-guest-form" action={preview_path(assigns, "/start")} method="post">
              <input type="hidden" name="avatar" value={@selected_avatar.id} />
              <input type="hidden" name="preset" value={if !@custom, do: @selected_build_index} />
              <input :for={skill <- @selected_skills} type="hidden" name="skills[]" value={skill.id} />
              <button type="submit" id="create-button" class="invoke-primary" disabled={length(@selected_skills) != 3}>
                <span class="invoke-launch-label">
                  <.icon
                    name={if Map.get(assigns, :draft_mode, false), do: "game-team", else: "nav-training"}
                    class="invoke-launch-icon"
                  />
                  <span>{Map.get(assigns, :launch_label, "Begin training")}</span>
                </span>
                <span aria-hidden="true">→</span>
              </button>
            </.form>
          <% end %>
          <p id="invoke-create-error" role="alert" hidden></p>
        </div>
      </div>
    </aside>
  </div>

  <section id="invoke-roster" class="invoke-roster" aria-label="Hero roster" hidden={@custom}>
    <nav class="invoke-filters" aria-label="Hero role">
      <button
        id="invoke-filter-all"
        type="button"
        data-invoke-action="filter"
        data-role=""
        aria-pressed={to_string(is_nil(@filter))}
      >
        All heroes
      </button>
      <button
        :for={role <- roles()}
        id={"invoke-filter-#{role}"}
        type="button"
        data-invoke-action="filter"
        data-role={role}
        aria-pressed={to_string(@filter == role)}
      >
        <img src={"/images/#{role}_icon.png"} alt="" />{String.capitalize(role)}
      </button>
      <button
        id="randomize-button"
        type="button"
        data-invoke-action="random"
        class="invoke-random"
        aria-label="Choose a random hero"
      >
        ↻ Random
      </button>
    </nav>
    <div class="invoke-avatar-strip">
      <button
        id="invoke-avatars-prev"
        type="button"
        class="invoke-roster-arrow"
        data-invoke-action="roster-page"
        data-direction="-1"
        aria-label="Previous heroes"
        aria-controls="invoke-avatars"
        hidden={length(@avatars) <= 12}
        disabled
      >
        <span aria-hidden="true">←</span>
      </button>
      <div
        id="invoke-avatars"
        class="invoke-avatar-grid"
        style={"--invoke-columns: #{min(12, max(1, length(@avatars)))}"}
      >
        <button
          :for={{avatar, index} <- @avatars |> Enum.uniq() |> Enum.sort_by(& &1.name) |> Enum.with_index()}
          hidden={index >= 12}
          id={"pick-avatar-#{avatar.id}"}
          type="button"
          class="invoke-portrait"
          data-invoke-action="avatar"
          data-avatar-id={avatar.id}
          data-role={avatar.role}
          aria-pressed={to_string(@selected_avatar.id == avatar.id)}
          aria-label={"Choose #{avatar.name}"}
        >
          <img src={GH.image_url(avatar)} alt="" />
          <span>{avatar.name}</span>
          <span
            :if={Enum.any?(@current_player.hero_collection, &(&1["code"] == avatar.code))}
            class="invoke-trained"
            aria-label="Already trained"
          >
            ◆
          </span>
        </button>
      </div>
      <button
        id="invoke-avatars-next"
        type="button"
        class="invoke-roster-arrow"
        data-invoke-action="roster-page"
        data-direction="1"
        aria-label="Next heroes"
        aria-controls="invoke-avatars"
        hidden={length(@avatars) <= 12}
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <div :if={@avatars == []} class="invoke-no-heroes">No unlocked heroes in this role.</div>
  </section>
  <template id="invoke-selected-skill-template">
    <div class="invoke-loadout-slot">
      <button type="button" data-invoke-action="skill">
        <img data-toggle="tooltip" alt="" /><span class="invoke-remove" aria-hidden="true">×</span>
      </button>
      <strong></strong>
      <span class="invoke-ultimate-meta">
        <small hidden>Ultimate</small><span class="invoke-energy"><.icon name="game-energy" class="invoke-stat-icon" /><span data-energy></span></span>
      </span>
    </div>
  </template>
  <template id="invoke-empty-skill-template">
    <div class="invoke-loadout-slot">
      <span class="invoke-empty" aria-label="Empty skill slot">＋</span><span class="invoke-empty-label">Choose a skill</span>
    </div>
  </template>
  <template id="invoke-build-option-template">
    <article class="invoke-build">
      <button type="button" data-invoke-action="build" class="invoke-build-pick">
        <span class="invoke-build-number"></span><strong></strong>
      </button>
      <div class="invoke-build-skills"></div>
    </article>
  </template>
</section>
