<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta
    name="Description"
    content="Train your own custom heroes with MOBA abilities and items to battle against other players in turn-based strategy matches. Online, no downloads, for free."
  />
  <.live_title prefix="Browser MOBA – ">
    {assigns[:page_title] || "Free Strategy Game"}
  </.live_title>
  <link rel="stylesheet" href={~p"/css/app.css"} />
  <link rel="icon" type="image/png" href={assigns[:favicon] || ~p"/images/favicon.png?v=helmet-wide"} />
  <.analytics conn={assigns[:conn]} />
</head>
