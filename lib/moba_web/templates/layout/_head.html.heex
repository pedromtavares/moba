<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta
    name="description"
    content="Train custom heroes with MOBA abilities and items to battle against other players in turn based 3v3 team battles or 1v1 duels. Free to play."
  />
  <title>{if assigns[:landing_page], do: "Free turn based RPG | Browser MOBA", else: "Browser MOBA"}</title>
  <link rel="stylesheet" href={~p"/css/app.css"} />
  <link rel="icon" type="image/png" href={assigns[:favicon] || ~p"/images/favicon.png?v=base"} />
  <.analytics conn={assigns[:conn]} />
</head>
