<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Browser MOBA - Free RPG</title>
    <link rel="stylesheet" href={~p"/css/app.css"} />
  </head>

  <body>
    <div class="account-pages mt-5 mb-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="card bg-pattern">
              <div class="card-body p-4">
                <div class="text-center">
                  <a href="index.html">
                    <span><img src="assets/images/logo-light.png" alt="" height="22" /></span>
                  </a>
                </div>

                <div class="text-center mt-4">
                  <h1 class="text-error">Oops!</h1>
                  <h3 class="mt-3 mb-2">There was a server error</h3>
                  <p class="text-muted mb-3">The admins have already been contacted and will fix this ASAP, sorry!</p>

                  <a href="/" class="btn btn-success waves-effect waves-light">Back to Home</a>
                </div>
              </div>
              <!-- end card-body -->
            </div>
            <!-- end card -->
          </div>
          <!-- end col -->
        </div>
        <!-- end row -->
      </div>
      <!-- end container -->
    </div>
    <!-- end page -->
  </body>
</html>
